<div id="search" class="input-group">
  <input type="text" name="search" value="{{ search }}" placeholder="{{ text_search }}" class="form-control input-lg" aria-label="{{ text_search }}" />
  <span class="input-group-btn">
    <button type="button" class="btn btn-default btn-lg" aria-label="{{ text_search }}" title="{{ text_search }}"><i class="fa fa-search" aria-hidden="true"></i></button>
  </span>
</div>
