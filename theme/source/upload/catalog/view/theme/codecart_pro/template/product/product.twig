      {{ content_bottom }}</div>{{ column_right }}</div>
</div>
<script>
{% if not ccp_information_mode_active %}
$('select[name=\'recurring_id\'], input[name="quantity"]').change(function(){ $.ajax({url:'index.php?route=product/product/getRecurringDescription', type:'post', data:$('input[name=\'product_id\'], input[name=\'quantity\'], select[name=\'recurring_id\']'), dataType:'json', beforeSend:function(){$('#recurring-description').html('');}, success:function(json){$('.alert-dismissible, .text-danger').remove(); if(json['success']){$('#recurring-description').html(json['success']);}}});});
$('#button-cart').on('click', function(){
  var $button = $('#button-cart');
  if ($button.data('ccp-busy')) { return; }
  var buttonHtml = $button.html();
  var loadingText = (window.CodeCartProTheme && window.CodeCartProTheme.textLoading) ? window.CodeCartProTheme.textLoading : ($button.data('loading-text') || '{{ text_loading|e('js') }}');
  var productData = $("#product input[type='text'], #product input[type='hidden'], #product input[type='radio']:checked, #product input[type='checkbox']:checked, #product select, #product textarea");
  var popupPayload = {trigger: $button[0], name: $.trim($('.ccp-product-header .ccp-product-title-top').first().text()), href: window.location.href, image: ($('[data-ccp-gallery-main] img').first().attr('src') || $('.ccp-product-gallery img').first().attr('src') || ''), qty: parseInt($('#input-quantity').val() || '1',10) || 1, price: $.trim($('.ccp-product-price .price-main').first().text() || $('.ccp-product-price').first().text())};
  if(window.CodeCartProTheme && window.CodeCartProTheme.cartAddPopup){window.CCP_PENDING_CART_POPUP = popupPayload;}
  function resetCartButton(){
    window.CCP_CART_SYNC_PENDING = false;
    $button.data('ccp-busy', false).prop('disabled', false).removeClass('disabled').html(buttonHtml);
    window.setTimeout(function(){ window.CCP_PRODUCT_ADD_ACTIVE = false; }, 900);
  }
  $button.data('ccp-busy', true).prop('disabled', true).addClass('disabled').html('<i class="fa fa-spinner fa-spin"></i> ' + loadingText);
  window.CCP_CART_SYNC_PENDING = true;
  window.CCP_PRODUCT_ADD_ACTIVE = true;
  window.setTimeout(resetCartButton, 8000);
  $.ajax({
    url:'index.php?route=checkout/cart/add',
    type:'post',
    data: productData,
    dataType:'json',
    success:function(json){
      $('.alert-dismissible, .text-danger').remove(); $('.form-group').removeClass('has-error');
      if(json['error']){
        resetCartButton();
        window.CCP_PENDING_CART_POPUP = null;
        if(json['error']['option']){for(i in json['error']['option']){var element=$('#input-option'+i.replace('_','-')); if(element.parent().hasClass('input-group')){element.parent().after('<div class="text-danger">'+json['error']['option'][i]+'</div>');}else{element.after('<div class="text-danger">'+json['error']['option'][i]+'</div>');}}}
        if(json['error']['recurring']){$("select[name='recurring_id']").after('<div class="text-danger">'+json['error']['recurring']+'</div>');}
        $('.text-danger').parent().addClass('has-error');
      }
      if(json['success']){
        var ccpCfg = window.CodeCartProTheme || {};
        var popupShown = false;
        if(ccpCfg.cartAddPopup && window.CodeCartProShowCartAddPopup){
          popupShown = window.CodeCartProShowCartAddPopup(popupPayload, json['total'], json.ccp_cart_item);
          window.CCP_PENDING_CART_POPUP = null;
        }
        resetCartButton();
        $('#cart > button').html('<span id="cart-total">'+json['total']+'</span>');
        $.ajax({url:'index.php?route=extension/module/codecart_pro_interaction/cartSyncQuantity', type:'post', data:productData, dataType:'json', complete:function(){
          $('#cart > ul').load('index.php?route=common/cart/info ul li');
          if(ccpCfg.directCheckoutAfterAdd && ccpCfg.checkoutUrl && !ccpCfg.cartAddPopup){window.location.href = ccpCfg.checkoutUrl; return;}
          if(!popupShown && window.CodeCartProRefreshCartDrawer){window.CodeCartProRefreshCartDrawer(true);}
          if(window.CodeCartProSyncProductQty){window.CodeCartProSyncProductQty();}
        }});
      }
    },
    error:function(){resetCartButton(); window.CCP_PENDING_CART_POPUP = null;}
  });
});
{% endif %}
{% if review_status %}var ccpReviewLoaded=false;function ccpLoadProductReviews(){if(ccpReviewLoaded){return;}ccpReviewLoaded=true;$('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');}$('#review').delegate('.pagination a','click',function(e){e.preventDefault();$('#review').fadeOut('slow');$('#review').load(this.href);$('#review').fadeIn('slow');});$(document).on('click','a[href="#tab-review"]',function(){ccpLoadProductReviews();});if(window.location.hash==='#tab-review'){ccpLoadProductReviews();}$('#button-review').on('click',function(){ $.ajax({url:'index.php?route=product/product/write&product_id={{ product_id }}', type:'post', dataType:'json', data:$('#form-review').serialize(), beforeSend:function(){$('#button-review').button('loading');}, complete:function(){$('#button-review').button('reset');}, success:function(json){$('.alert-dismissible').remove(); if(json['error']){$('#review').after('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> '+json['error']+'</div>');} if(json['success']){$('#review').after('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> '+json['success']+'</div>');$('input[name=\'name\']').val('');$('textarea[name=\'text\']').val('');$('input[name=\'rating\']:checked').prop('checked',false);ccpReviewLoaded=false;ccpLoadProductReviews();}}});});{% endif %}
