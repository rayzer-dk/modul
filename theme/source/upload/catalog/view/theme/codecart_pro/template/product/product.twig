      </div>
      {% if ccp_product_commercial_blocks is defined %}{{ ccp_product_commercial_blocks }}{% endif %}
      {% if ccp_product_articles is defined %}{{ ccp_product_articles }}{% endif %}
      {% if not ccp_information_mode_active and (ccp_product_bottom_sticky_buy is defined ? ccp_product_bottom_sticky_buy : 1) and (ccp_product_bottom_sticky_buy_mobile is defined ? ccp_product_bottom_sticky_buy_mobile : 1) %}
      <div class="ccp-mobile-buy-panel ccp-sticky-mobile" data-ccp-single-sticky-buy="1" aria-hidden="true">
        <div class="ccp-mobile-buy-inner">
          <div class="ccp-sticky-main-nav"><a href="{{ ccp_sticky_home|default('index.php?route=common/home') }}" class="ccp-sticky-nav-link"><i class="fa fa-home"></i><span>{{ ccp_text_home|default('Home') }}</span></a><a href="#ccp-mobile-menu" class="ccp-sticky-nav-link" data-ccp-mobile-menu-toggle><i class="fa fa-th-large"></i><span>{{ ccp_text_catalog_short|default('Catalog') }}</span></a><a href="{{ ccp_sticky_cart|default('index.php?route=checkout/cart') }}" class="ccp-sticky-nav-link"><i class="fa fa-shopping-cart"></i><span>{{ ccp_text_cart_short|default('Cart') }}</span></a></div>
          <div class="ccp-mobile-buy-price">{% if price %}{% if special %}{{ special }}{% else %}{{ price }}{% endif %}{% endif %}</div>
          <div class="ccp-mobile-buy-qty" data-ccp-sticky-qty><button type="button" data-ccp-sticky-qty="minus" aria-label="{{ ccp_text_minus|default('Decrease quantity') }}">−</button><input type="text" value="{{ minimum }}" inputmode="numeric" min="{{ minimum }}" aria-label="{{ entry_qty|e('html_attr') }}" data-ccp-sticky-qty-input><button type="button" data-ccp-sticky-qty="plus" aria-label="{{ ccp_text_plus|default('Increase quantity') }}">+</button></div>
          <button type="button" class="btn ccp-btn ccp-mobile-buy-cart" data-ccp-mobile-cart="1"><i class="fa fa-shopping-cart"></i> {{ button_cart }}</button>
