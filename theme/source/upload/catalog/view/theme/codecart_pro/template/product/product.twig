    </div>{% endif %}
    <a href="{{ product.href }}" class="ccp-product-image-link{% if ccp_card_second_image_status and product.ccp_second_thumb is defined and product.ccp_second_thumb %} ccp-has-second-image{% endif %}"><img class="ccp-img-main" src="{{ product.thumb }}" alt="{{ product.name }}" loading="{{ ccp_img_loading }}"{% if ccp_performance_image_decoding_status|default(1) %} decoding="async"{% endif %}{% if ccp_card_eager and ccp_performance_fetchpriority_status|default(1) %} fetchpriority="high"{% endif %} width="640" height="407" />{% if ccp_card_second_image_status and product.ccp_second_thumb is defined and product.ccp_second_thumb %}<img class="ccp-img-second" src="{{ product.ccp_second_thumb }}" alt="{{ product.name }}" loading="lazy"{% if ccp_performance_image_decoding_status|default(1) %} decoding="async"{% endif %} width="640" height="407" />{% endif %}</a>
  </div>
  <div class="ccp-product-card__body">
    <div class="ccp-product-card__name"><a href="{{ product.href }}">{{ product.name }}</a></div>
    {% if ccp_card_meta_position == 'under_title' and ((ccp_card_show_model and product.ccp_model is defined and product.ccp_model) or (ccp_card_show_manufacturer and product.ccp_manufacturer is defined and product.ccp_manufacturer)) %}<div class="ccp-product-card__meta ccp-card-meta-{{ ccp_card_meta_position }}">{% if ccp_card_show_manufacturer and product.ccp_manufacturer is defined and product.ccp_manufacturer %}<span><i class="fa fa-industry"></i> {{ product.ccp_manufacturer }}</span>{% endif %}{% if ccp_card_show_model and product.ccp_model is defined and product.ccp_model %}<span><i class="fa fa-barcode"></i> {{ product.ccp_model }}</span>{% endif %}</div>{% endif %}
    {% if ccp_card_show_description %}<div class="ccp-product-card__desc">{% if product.description %}{{ product.description }}{% else %}&nbsp;{% endif %}</div>{% endif %}
    {% if ccp_card_show_rating and product.rating %}<div class="ccp-product-card__rating" aria-label="{{ product.rating }}/5">{% for i in 1..5 %}{% if product.rating < i %}<i class="fa fa-star-o"></i>{% else %}<i class="fa fa-star"></i>{% endif %}{% endfor %}</div>{% endif %}
    {% if product.price and not ccp_information_mode_active %}<div class="ccp-product-card__price">{% if not product.special %}{{ product.price }}{% else %}<span class="price-new">{{ product.special }}</span><span class="price-old">{{ product.price }}</span>{% endif %}{% if product.tax %}<span class="price-tax">{{ text_tax }} {{ product.tax }}</span>{% endif %}</div>{% endif %}
    {% if ccp_card_meta_position == 'under_price' and ((ccp_card_show_model and product.ccp_model is defined and product.ccp_model) or (ccp_card_show_manufacturer and product.ccp_manufacturer is defined and product.ccp_manufacturer)) %}<div class="ccp-product-card__meta ccp-card-meta-{{ ccp_card_meta_position }}">{% if ccp_card_show_manufacturer and product.ccp_manufacturer is defined and product.ccp_manufacturer %}<span><i class="fa fa-industry"></i> {{ product.ccp_manufacturer }}</span>{% endif %}{% if ccp_card_show_model and product.ccp_model is defined and product.ccp_model %}<span><i class="fa fa-barcode"></i> {{ product.ccp_model }}</span>{% endif %}</div>{% endif %}
    {% if ccp_card_show_stock and ccp_card_stock_mode != 'hide' %}{% if product.ccp_stock_status is defined %}<div class="ccp-product-card__stock ccp-stock-{{ product.ccp_stock_class|default('in') }}"><i class="fa fa-check-circle"></i> {{ product.ccp_stock_status }}</div>{% elseif ccp_card_stock_mode == 'always' %}<div class="ccp-product-card__stock ccp-stock-soft"><i class="fa fa-check-circle"></i> {{ ccp_text_in_stock|default('In stock') }}</div>{% endif %}{% endif %}
    <div class="ccp-product-card__actions{% if not ccp_card_show_buy_button or ccp_information_mode_active %} ccp-no-buy{% endif %}">
      {% if ccp_card_show_quantity and not ccp_information_mode_active %}<div class="ccp-card-qty"><button type="button" class="ccp-qty-btn" data-ccp-qty="minus">−</button><input type="text" value="{{ product.minimum|default(1) }}" inputmode="numeric" min="{{ product.minimum|default(1) }}" aria-label="{{ ccp_text_quantity|default('Quantity') }}"><button type="button" class="ccp-qty-btn" data-ccp-qty="plus">+</button></div>{% endif %}
      {% if ccp_card_show_buy_button and not ccp_information_mode_active %}<button type="button" class="btn ccp-btn ccp-card-cart" data-product-id="{{ product.product_id }}"><i class="fa fa-shopping-cart"></i> <span>{{ button_cart }}</span></button>{% endif %}
      {% if not ccp_information_mode_active and (ccp_enable_quick_order is not defined or ccp_enable_quick_order) %}<button type="button" class="ccp-mini-btn ccp-js-quick-order" data-product-id="{{ product.product_id }}" data-product-name="{{ product.name|e('html_attr') }}" title="{{ ccp_button_quick_order|default('Buy in 1 click') }}"><i class="fa fa-bolt"></i></button>{% endif %}
      {% if ccp_card_show_wishlist %}<button type="button" class="ccp-mini-btn" onclick="wishlist.add('{{ product.product_id }}');" title="{{ button_wishlist|default('Wishlist') }}"><i class="fa fa-heart"></i></button>{% endif %}
      {% if ccp_card_show_compare %}<button type="button" class="ccp-mini-btn" onclick="compare.add('{{ product.product_id }}');" title="{{ button_compare|default('Compare') }}"><i class="fa fa-exchange"></i></button>{% endif %}
    </div>
  </div>
</div>
{% endfor %}</div></div></div>{% endif %}
      <div class="ccp-share-modal" id="ccpShareModal" tabindex="-1" role="dialog" aria-hidden="true" inert>
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h4 class="modal-title">{{ ccp_text_share|default('Share') }}</h4>
              <button type="button" class="close ccp-share-close" data-ccp-share-close aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
              <div class="ccp-share-links">
                <a class="ccp-share-link ccp-share-viber" data-ccp-share-link="viber" href="#" target="_blank" rel="noopener"><span class="ccp-share-icon">V</span><span>Viber</span></a>
                <a class="ccp-share-link ccp-share-facebook" data-ccp-share-link="facebook" href="#" target="_blank" rel="noopener"><span class="ccp-share-icon">f</span><span>Facebook</span></a>
                <a class="ccp-share-link ccp-share-telegram" data-ccp-share-link="telegram" href="#" target="_blank" rel="noopener"><span class="ccp-share-icon">T</span><span>Telegram</span></a>
                <a class="ccp-share-link ccp-share-whatsapp" data-ccp-share-link="whatsapp" href="#" target="_blank" rel="noopener"><span class="ccp-share-icon">W</span><span>WhatsApp</span></a>
                <a class="ccp-share-link ccp-share-x" data-ccp-share-link="x" href="#" target="_blank" rel="noopener"><span class="ccp-share-icon">X</span><span>X</span></a>
              </div>
              <button type="button" class="btn ccp-share-copy-btn" data-ccp-copy-share>{{ ccp_text_copy_link|default('Copy page link') }}</button>
            </div>
          </div>
