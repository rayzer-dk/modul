{{ header }}
<div id="checkout-cart" class="container ccp-checkout-cart-page">
  <ul class="breadcrumb ccp-checkout-breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if attention %}
  <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ attention }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}{% if weight %} <span class="ccp-cart-weight">{{ weight }}</span>{% endif %}</h1>
      <form action="{{ action }}" method="post" enctype="multipart/form-data" id="ccp-cart-page-form">
        <div class="table-responsive ccp-cart-page-table-wrap">
          <table class="table table-bordered ccp-cart-page-table">
            <thead>
              <tr>
                <td class="text-center ccp-cart-col-image">{{ column_image }}</td>
                <td class="text-left">{{ column_name }}</td>
                <td class="text-left ccp-cart-col-model">{{ column_model }}</td>
                <td class="text-left ccp-cart-col-qty">{{ column_quantity }}</td>
                <td class="text-right ccp-cart-col-price">{{ column_price }}</td>
                <td class="text-right ccp-cart-col-total">{{ column_total }}</td>
              </tr>
            </thead>
            <tbody>
            {% for product in products %}
            <tr>
              <td class="text-center ccp-cart-col-image">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" width="70" height="70" loading="lazy" decoding="async" class="img-thumbnail" /></a>{% endif %}</td>
              <td class="text-left ccp-cart-product-name"><a href="{{ product.href }}">{{ product.name }}</a>{% if not product.stock %} <span class="text-danger">***</span>{% endif %}
                {% if product.option %}
                {% for option in product.option %}<br /><small>{{ option.name }}: {{ option.value }}</small>{% endfor %}
                {% endif %}
                {% if product.reward and not ccp_checkout_hide_reward_status %}<br /><small>{{ product.reward }}</small>{% endif %}
                {% if product.recurring %}<br /><span class="label label-info">{{ text_recurring_item }}</span> <small>{{ product.recurring }}</small>{% endif %}</td>
              <td class="text-left ccp-cart-col-model">{{ product.model }}</td>
              <td class="text-left ccp-cart-col-qty">
                <div class="ccp-cart-page-qty" data-ccp-cart-page-qty-wrap>
                  <div class="ccp-cart-page-qty-control">
                    <button type="button" class="ccp-cart-page-qty-btn" data-ccp-cart-page-qty="minus" aria-label="Minus">−</button>
                    <input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" size="1" class="form-control" inputmode="numeric" min="1" />
                    <button type="button" class="ccp-cart-page-qty-btn" data-ccp-cart-page-qty="plus" aria-label="Plus">+</button>
                  </div>
                  <div class="ccp-cart-page-actions">
                    <button type="submit" data-toggle="tooltip" title="{{ button_update }}" class="btn ccp-cart-page-update"><i class="fa fa-refresh"></i></button>
                    <button type="button" data-toggle="tooltip" title="{{ button_remove }}" class="btn ccp-cart-page-remove" onclick="cart.remove('{{ product.cart_id }}');"><i class="fa fa-times"></i></button>
                  </div>
                </div>
              </td>
              <td class="text-right ccp-cart-col-price">{{ product.price }}</td>
              <td class="text-right ccp-cart-col-total">{{ product.total }}</td>
            </tr>
            {% endfor %}
            {% for voucher in vouchers %}
            <tr>
              <td></td>
              <td class="text-left">{{ voucher.description }}</td>
              <td class="text-left"></td>
              <td class="text-left">
                <div class="ccp-cart-page-qty is-disabled">
                  <input type="text" name="" value="1" size="1" disabled="disabled" class="form-control" />
                  <button type="button" data-toggle="tooltip" title="{{ button_remove }}" class="btn ccp-cart-page-remove" onclick="voucher.remove('{{ voucher.key }}');"><i class="fa fa-times"></i></button>
                </div>
              </td>
              <td class="text-right">{{ voucher.amount }}</td>
              <td class="text-right">{{ voucher.amount }}</td>
            </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </form>
      {% if modules and not (ccp_checkout_hide_coupon_status and ccp_checkout_hide_voucher_status and ccp_checkout_hide_reward_status) %}
      <h2>{{ text_next }}</h2>
      <p>{{ text_next_choice }}</p>
      <div class="panel-group" id="accordion">{% for module in modules %}{{ module }}{% endfor %}</div>
      {% endif %}<br />
      <div class="row">
        <div class="col-sm-4 col-sm-offset-8 ccp-cart-totals-wrap">
          <table class="table table-bordered ccp-cart-totals">
            {% for total in totals %}
            <tr>
              <td class="text-right"><strong>{{ total.title }}:</strong></td>
              <td class="text-right">{{ total.text }}</td>
            </tr>
            {% endfor %}
          </table>
        </div>
      </div>
      <div class="buttons clearfix ccp-cart-page-buttons">
        <div class="pull-left"><a href="{{ continue }}" class="btn btn-default">{{ button_shopping }}</a></div>
        <div class="pull-right"><a href="{{ checkout }}" class="btn ccp-btn btn-primary">{{ button_checkout }}</a></div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script>
(function($){
  $(document).on('click', '[data-ccp-cart-page-qty]', function(){
    var $wrap = $(this).closest('[data-ccp-cart-page-qty-wrap]');
    var $input = $wrap.find('input[name^="quantity"]');
    var value = parseInt(($input.val() || '1').replace(/[^0-9]/g, ''), 10);
    if (!value || value < 1) value = 1;
    if ($(this).data('ccp-cart-page-qty') === 'plus') value++;
    if ($(this).data('ccp-cart-page-qty') === 'minus') value = Math.max(1, value - 1);
    $input.val(value).trigger('change');
  });
  $(document).on('keydown', '.ccp-cart-page-qty input[name^="quantity"]', function(e){
    if (e.key === 'ArrowUp') { e.preventDefault(); $(this).closest('[data-ccp-cart-page-qty-wrap]').find('[data-ccp-cart-page-qty="plus"]').trigger('click'); }
    if (e.key === 'ArrowDown') { e.preventDefault(); $(this).closest('[data-ccp-cart-page-qty-wrap]').find('[data-ccp-cart-page-qty="minus"]').trigger('click'); }
  });
})(jQuery);
</script>
{{ footer }}
