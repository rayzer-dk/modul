{{ header }}{{ column_left }}
<div id="content" class="ccp-admin-module ccp-admin-review ccp-admin-review-v861">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ view_product }}" target="_blank" rel="noopener" class="btn btn-info"><i class="fa fa-external-link"></i> <span>{{ button_view }}</span></a>
        <button type="submit" form="form-review" class="btn btn-primary"><i class="fa fa-save"></i> <span>{{ button_save }}</span></button>
        <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> <span>{{ button_cancel }}</span></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-review" class="form-horizontal">
      <div class="panel panel-default ccp-review-editor-panel">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
        <div class="panel-body">
          <div class="ccp-review-product-strip">
            <div><small>{{ entry_product }}</small><strong>{{ review.product|escape }}</strong></div>
            <div><small>{{ entry_date_added }}</small><strong>{{ review.date_added|escape }}</strong></div>
            <div><small>ID</small><strong>#{{ review.review_id }}</strong></div>
          </div>

          <ul class="nav nav-tabs ccp-review-tabs">
            <li class="active"><a href="#tab-review-main" data-toggle="tab"><i class="fa fa-comment"></i> {{ text_tab_review }}</a></li>
            <li><a href="#tab-review-details" data-toggle="tab"><i class="fa fa-list-alt"></i> {{ text_tab_details }}</a></li>
            <li><a href="#tab-review-reply" data-toggle="tab"><i class="fa fa-reply"></i> {{ text_tab_reply }}</a></li>
            <li><a href="#tab-review-service" data-toggle="tab"><i class="fa fa-cog"></i> {{ text_tab_service }}</a></li>
          </ul>

          <div class="tab-content ccp-review-tab-content">
            <div class="tab-pane active" id="tab-review-main">
              <div class="ccp-tab-intro"><i class="fa fa-info-circle"></i> {{ text_review_information }}</div>
              <div class="form-group required{% if error_author %} has-error{% endif %}"><label class="col-sm-2 control-label" for="input-review-author">{{ entry_author }}</label><div class="col-sm-10"><input type="text" name="author" value="{{ review.author|escape }}" id="input-review-author" class="form-control" maxlength="64" />{% if error_author %}<div class="text-danger">{{ error_author }}</div>{% endif %}</div></div>
              <div class="form-group required{% if error_text %} has-error{% endif %}"><label class="col-sm-2 control-label" for="input-review-text">{{ entry_review_text }}</label><div class="col-sm-10"><textarea name="text" rows="9" id="input-review-text" class="form-control" maxlength="5000">{{ review.text|escape }}</textarea><p class="help-block">{{ help_review_text }}</p>{% if error_text %}<div class="text-danger">{{ error_text }}</div>{% endif %}</div></div>
              <div class="ccp-review-main-grid">
                <div class="form-group required{% if error_rating %} has-error{% endif %}"><label class="control-label">{{ entry_rating }}</label><div class="ccp-rating-picker">{% for i in 1..5 %}<label><input type="radio" name="rating" value="{{ i }}"{% if review.rating == i %} checked{% endif %} /><span><i class="fa fa-star"></i>{{ i }}</span></label>{% endfor %}</div>{% if error_rating %}<div class="text-danger">{{ error_rating }}</div>{% endif %}</div>
                <div class="form-group"><label class="control-label" for="input-review-status">{{ entry_status }}</label><select name="status" id="input-review-status" class="form-control"><option value="1"{% if review.status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not review.status %} selected{% endif %}>{{ text_disabled }}</option></select></div>
              </div>
            </div>

            <div class="tab-pane" id="tab-review-details">
              <div class="ccp-tab-intro"><i class="fa fa-info-circle"></i> {{ text_review_details }}</div>
              <div class="ccp-two-column-fields">
                <div class="form-group"><label class="control-label" for="input-review-plus">{{ entry_plus }}</label><textarea name="plus_text" rows="6" id="input-review-plus" class="form-control">{{ plus_text|escape }}</textarea></div>
                <div class="form-group"><label class="control-label" for="input-review-minus">{{ entry_minus }}</label><textarea name="minus_text" rows="6" id="input-review-minus" class="form-control">{{ minus_text|escape }}</textarea></div>
              </div>
              <div class="form-group ccp-checkbox-card"><label><input type="checkbox" name="real_buyer" value="1"{% if real_buyer %} checked{% endif %} /> <span>{{ entry_real_buyer }}</span></label><p class="help-block">{{ help_real_buyer }}</p></div>
              <div class="form-group ccp-review-images-field"><label class="control-label">{{ entry_images }}</label><p class="help-block">{{ help_images }}</p><div id="review-image-list" class="ccp-review-image-list">{% set image_row = 0 %}{% for image in review_images %}<div class="ccp-review-image-row" id="review-image-row-{{ image_row }}"><a href="" id="thumb-review-image-{{ image_row }}" data-toggle="image" class="img-thumbnail"><img src="{{ image.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="images[]" value="{{ image.image|escape }}" id="input-review-image-{{ image_row }}" /><button type="button" class="btn btn-danger" data-ccp-remove-review-image><i class="fa fa-trash-o"></i> {{ button_remove }}</button></div>{% set image_row = image_row + 1 %}{% endfor %}</div><button type="button" class="btn btn-default" id="button-add-review-image"><i class="fa fa-plus"></i> {{ button_add_image }}</button></div>
            </div>

            <div class="tab-pane" id="tab-review-reply">
              <div class="ccp-tab-intro"><i class="fa fa-info-circle"></i> {{ text_reply_information }}</div>
              <div class="form-group"><label class="control-label" for="input-admin-reply">{{ entry_admin_reply }}</label><textarea name="admin_reply" rows="10" id="input-admin-reply" class="form-control">{{ admin_reply|escape }}</textarea><p class="help-block">{{ help_admin_reply }}</p></div>
            </div>

            <div class="tab-pane" id="tab-review-service">
              <div class="ccp-tab-intro"><i class="fa fa-info-circle"></i> {{ text_service_information }}</div>
              <div class="ccp-service-stats"><div><span>{{ entry_votes_plus }}</span><strong>{{ votes_plus }}</strong></div><div><span>{{ entry_votes_minus }}</span><strong>{{ votes_minus }}</strong></div></div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
var reviewImageRow = {{ review_images|length }};
$('#button-add-review-image').on('click', function(){
  var row = reviewImageRow++;
  var html = '<div class="ccp-review-image-row" id="review-image-row-' + row + '">';
  html += '<a href="" id="thumb-review-image-' + row + '" data-toggle="image" class="img-thumbnail"><img src="{{ placeholder|escape('js') }}" alt="" title="" data-placeholder="{{ placeholder|escape('js') }}" /></a>';
  html += '<input type="hidden" name="images[]" value="" id="input-review-image-' + row + '" />';
  html += '<button type="button" class="btn btn-danger" data-ccp-remove-review-image><i class="fa fa-trash-o"></i> {{ button_remove|escape('js') }}</button></div>';
  $('#review-image-list').append(html);
});
$('#review-image-list').on('click', '[data-ccp-remove-review-image]', function(){ $(this).closest('.ccp-review-image-row').remove(); });
//--></script>
{{ footer }}
