{{ header }}{{ column_left }}
<div id="content" class="ccp-admin-module ccp-admin-blog ccp-admin-blog-v861">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><a href="{{ add }}" class="btn btn-primary"><i class="fa fa-plus"></i> <span>{{ button_add }}</span></a><a href="{{ back }}" class="btn btn-default"><i class="fa fa-newspaper-o"></i> <span>{{ button_articles }}</span></a></div><h1>{{ heading_category_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible" role="alert"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible" role="status"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    <div class="panel panel-default ccp-compact-panel">
      <div class="panel-heading ccp-panel-heading-actions"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3><button type="button" class="btn btn-default btn-sm" data-toggle="collapse" data-target="#ccp-category-tools"><i class="fa fa-wrench"></i> {{ button_tools }}</button></div>
      <div class="panel-body"><form action="index.php" method="get" id="form-codecart-blog-category-filter"><input type="hidden" name="route" value="extension/module/codecart_pro_blog/categories" /><input type="hidden" name="user_token" value="{{ user_token }}" /><input type="hidden" name="filter_store_category_id" value="{{ filter_store_category_id }}" id="input-filter-store-category-id" /><div class="ccp-filter-grid ccp-filter-grid-category"><div><label for="input-filter-name">{{ entry_filter_name }}</label><input type="text" name="filter_name" value="{{ filter_name }}" id="input-filter-name" class="form-control" /></div><div><label for="input-filter-keyword">{{ entry_filter_keyword }}</label><input type="text" name="filter_keyword" value="{{ filter_keyword }}" id="input-filter-keyword" class="form-control" /></div><div><label for="input-filter-status">{{ entry_filter_status }}</label><select name="filter_status" id="input-filter-status" class="form-control"><option value=""></option><option value="1"{% if filter_status == '1' %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if filter_status == '0' %} selected{% endif %}>{{ text_disabled }}</option></select></div><div><label for="input-filter-store-category-name">{{ entry_filter_store_category }}</label><input type="text" name="filter_store_category_name" value="{{ filter_store_category_name }}" id="input-filter-store-category-name" class="form-control" /></div><div class="ccp-filter-buttons"><button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> {{ button_filter }}</button><a href="{{ clear_filter }}" class="btn btn-default"><i class="fa fa-eraser"></i> {{ button_clear_filter }}</a></div></div></form></div>
    </div>

    <div class="collapse" id="ccp-category-tools"><div class="panel panel-default ccp-tools-panel"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-wrench"></i> {{ text_tools }}</h3></div><div class="panel-body ccp-blog-tools-grid"><div class="ccp-tool-card"><h4><i class="fa fa-file-code-o"></i> SEO</h4><div class="ccp-tool-actions"><a href="{{ seo_audit }}" class="btn btn-info"><i class="fa fa-search-plus"></i> {{ button_seo_audit }}</a><a href="{{ regenerate_seo }}" class="btn btn-warning"><i class="fa fa-refresh"></i> {{ button_regenerate_seo }}</a></div></div><div class="ccp-tool-card"><h4><i class="fa fa-exchange"></i> CSV</h4><div class="ccp-tool-actions"><a href="{{ export }}" class="btn btn-success"><i class="fa fa-download"></i> {{ button_export }}</a><form action="{{ import }}" method="post" enctype="multipart/form-data" class="ccp-import-form"><input type="file" name="import_file" accept=".csv,text/csv" class="form-control" /><button type="submit" class="btn btn-success"><i class="fa fa-upload"></i> {{ button_import }}</button></form><p class="help-block">{{ help_import_categories }}</p></div></div></div></div></div>

    <div class="panel panel-default">
      <div class="panel-heading ccp-panel-heading-actions"><h3 class="panel-title"><i class="fa fa-folder-open"></i> {{ text_category_list }}</h3><div class="ccp-bulk-controls"><select name="bulk_action" form="form-codecart-blog-category" class="form-control"><option value="">{{ text_bulk_none }}</option><option value="enable">{{ text_bulk_enable }}</option><option value="disable">{{ text_bulk_disable }}</option><option value="regenerate_seo">{{ text_bulk_regenerate_seo }}</option></select><button type="submit" form="form-codecart-blog-category" formaction="{{ bulk }}" class="btn btn-primary"><i class="fa fa-check"></i> {{ button_bulk_apply }}</button><button type="submit" form="form-codecart-blog-category" formaction="{{ delete }}" class="btn btn-danger" data-ccp-category-delete><i class="fa fa-trash-o"></i> {{ button_delete }}</button></div></div>
      <div class="panel-body"><form method="post" id="form-codecart-blog-category"><div class="table-responsive" role="region" tabindex="0" aria-label="{{ heading_title|striptags|e('html_attr') }}"><table class="table table-bordered table-hover ccp-blog-table"><thead><tr><td class="text-center" style="width:42px;"><input type="checkbox" data-ccp-select-all /></td><td>{{ column_image }}</td><td>{{ column_name }}</td><td>{{ column_keyword }}</td><td>{{ column_status }}</td><td>{{ column_sort_order }}</td><td class="text-right">{{ column_action }}</td></tr></thead><tbody>{% if categories %}{% for category in categories %}<tr><td class="text-center"><input type="checkbox" name="selected[]" value="{{ category.category_id }}" /></td><td><img src="{{ category.thumb }}" alt="" class="img-thumbnail ccp-blog-list-thumb" /></td><td><strong>{{ category.name }}</strong><div class="ccp-muted-line">#{{ category.category_id }}</div></td><td>{{ category.keyword }}</td><td>{% if category.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</td><td><input type="number" name="sort_order[{{ category.category_id }}]" value="{{ category.sort_order }}" class="form-control input-sm ccp-sort-input" /></td><td class="text-right"><a href="{{ category.view }}" target="_blank" rel="noopener" class="btn btn-info btn-sm" aria-label="{{ button_view }}" title="{{ button_view }}"><i class="fa fa-external-link" aria-hidden="true"></i></a><a href="{{ category.edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i> {{ button_edit }}</a></td></tr>{% endfor %}{% else %}<tr><td colspan="7" class="text-center ccp-empty-state"><i class="fa fa-folder-open-o"></i><span>{{ text_no_results }}</span></td></tr>{% endif %}</tbody></table></div></form><div class="row"><div class="col-sm-6 text-left">{{ pagination }}</div><div class="col-sm-6 text-right ccp-results-text">{{ results }}</div></div></div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('[data-ccp-select-all]').on('change', function(){ $('#form-codecart-blog-category input[name="selected[]"]').prop('checked', this.checked); });
$('[data-ccp-category-delete]').on('click', function(e){ if (!confirm('{{ text_confirm|escape('js') }}')) { e.preventDefault(); } });
$('#input-filter-store-category-name').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=extension/module/codecart_pro_blog/autocompleteStoreCategory&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return {label:item.name,value:item.category_id};}));}});},select:function(item){$('#input-filter-store-category-name').val(item.label);$('#input-filter-store-category-id').val(item.value);}});
$('#input-filter-store-category-name').on('input', function(){if(!$(this).val()){$('#input-filter-store-category-id').val('0');}});
//--></script>
{{ footer }}
