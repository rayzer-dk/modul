{{ header }}{{ column_left }}
<div id="content" class="ccp-admin-module ccp-admin-review ccp-admin-review-v861">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ back }}" class="btn btn-default"><i class="fa fa-reply"></i> <span>{{ button_back }}</span></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible" role="alert"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible" role="status"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    <div class="ccp-review-summary-grid">
      <div class="ccp-admin-stat"><i class="fa fa-comments"></i><div><strong>{{ summary.total }}</strong><span>{{ text_summary_total }}</span></div></div>
      <div class="ccp-admin-stat is-success"><i class="fa fa-check-circle"></i><div><strong>{{ summary.enabled }}</strong><span>{{ text_summary_enabled }}</span></div></div>
      <div class="ccp-admin-stat is-warning"><i class="fa fa-clock-o"></i><div><strong>{{ summary.disabled }}</strong><span>{{ text_summary_disabled }}</span></div></div>
      <div class="ccp-admin-stat"><i class="fa fa-shopping-bag"></i><div><strong>{{ summary.verified }}</strong><span>{{ text_summary_verified }}</span></div></div>
      <div class="ccp-admin-stat"><i class="fa fa-camera"></i><div><strong>{{ summary.with_photos }}</strong><span>{{ text_summary_photos }}</span></div></div>
      <div class="ccp-admin-stat is-rating"><i class="fa fa-star"></i><div><strong>{{ summary.average_rating|number_format(2, '.', '') }}</strong><span>{{ text_summary_average }}</span></div></div>
    </div>

    <div class="panel panel-default ccp-compact-panel">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ button_filter }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="get" class="ccp-review-filter-form">
          <input type="hidden" name="route" value="extension/module/codecart_pro_review" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          <div class="ccp-filter-grid ccp-filter-grid-review">
            <div><label for="filter-author">{{ entry_author }}</label><input id="filter-author" type="text" name="filter_author" value="{{ filter_author|escape }}" class="form-control" /></div>
            <div><label for="filter-product">{{ entry_product }}</label><input id="filter-product" type="text" name="filter_product" value="{{ filter_product|escape }}" class="form-control" /></div>
            <div><label for="filter-text">{{ entry_filter_text }}</label><input id="filter-text" type="text" name="filter_text" value="{{ filter_text|escape }}" class="form-control" /></div>
            <div><label for="filter-rating">{{ entry_rating }}</label><select id="filter-rating" name="filter_rating" class="form-control"><option value="0"></option>{% for i in 1..5 %}<option value="{{ i }}"{% if filter_rating == i %} selected{% endif %}>{{ i }}/5</option>{% endfor %}</select></div>
            <div><label for="filter-status">{{ entry_status }}</label><select id="filter-status" name="filter_status" class="form-control"><option value=""></option><option value="1"{% if filter_status == '1' %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if filter_status == '0' %} selected{% endif %}>{{ text_disabled }}</option></select></div>
            <div><label for="filter-real-buyer">{{ entry_real_buyer }}</label><select id="filter-real-buyer" name="filter_real_buyer" class="form-control"><option value=""></option><option value="1"{% if filter_real_buyer == '1' %} selected{% endif %}>{{ text_yes }}</option><option value="0"{% if filter_real_buyer == '0' %} selected{% endif %}>{{ text_no }}</option></select></div>
            <div class="ccp-filter-buttons"><button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> {{ button_filter }}</button><a href="{{ clear }}" class="btn btn-default"><i class="fa fa-eraser"></i> {{ button_clear }}</a></div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading ccp-panel-heading-actions">
        <h3 class="panel-title"><i class="fa fa-comments"></i> {{ text_list }}</h3>
        <div class="ccp-bulk-controls">
          <select name="bulk_action" form="form-codecart-review" class="form-control">
            <option value="">{{ text_select_action }}</option>
            <option value="enable">{{ text_bulk_enable }}</option>
            <option value="disable">{{ text_bulk_disable }}</option>
            <option value="verified">{{ text_bulk_verified }}</option>
            <option value="unverified">{{ text_bulk_unverified }}</option>
            <option value="delete">{{ text_bulk_delete }}</option>
          </select>
          <button type="submit" form="form-codecart-review" formaction="{{ bulk }}" class="btn btn-primary" data-ccp-review-bulk><i class="fa fa-check"></i> {{ button_apply }}</button>
        </div>
      </div>
      <div class="panel-body">
        <form action="{{ bulk }}" method="post" id="form-codecart-review">
          <div class="table-responsive" role="region" tabindex="0" aria-label="{{ heading_title|striptags|e('html_attr') }}">
            <table class="table table-bordered table-hover ccp-review-table">
              <thead><tr><td class="text-center" style="width:42px;"><input type="checkbox" data-ccp-select-all /></td><td>{{ column_review }}</td><td>{{ column_product }}</td><td>{{ column_rating }}</td><td>{{ column_status }}</td><td>{{ column_details }}</td><td>{{ column_date_added }}</td><td class="text-right">{{ column_action }}</td></tr></thead>
              <tbody>
                {% if reviews %}
                  {% for review in reviews %}
                    <tr>
                      <td class="text-center"><input type="checkbox" name="selected[]" value="{{ review.review_id }}" /></td>
                      <td class="ccp-review-main-cell"><strong>{{ review.author|escape }}</strong><div class="ccp-review-excerpt">{{ review.text|escape }}</div></td>
                      <td><a href="{{ review.view_product }}" target="_blank" rel="noopener">{{ review.product|escape }}</a></td>
                      <td><span class="ccp-admin-stars" aria-label="{{ review.rating }}/5">{% for i in 1..5 %}<i class="fa fa-star{% if review.rating < i %}-o{% endif %}"></i>{% endfor %}</span></td>
                      <td>{% if review.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-warning">{{ text_disabled }}</span>{% endif %}</td>
                      <td><div class="ccp-review-badges">{% if review.real_buyer %}<span class="label label-success"><i class="fa fa-check"></i> {{ entry_real_buyer }}</span>{% endif %}{% if review.images_count %}<span class="label label-info"><i class="fa fa-camera"></i> {{ review.images_count }}</span>{% endif %}{% if review.has_reply %}<span class="label label-primary"><i class="fa fa-reply"></i> {{ text_tab_reply }}</span>{% endif %}</div></td>
                      <td>{{ review.date_added|escape }}</td>
                      <td class="text-right"><a href="{{ review.edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i> {{ button_edit }}</a></td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr><td colspan="8" class="text-center ccp-empty-state"><i class="fa fa-comments-o"></i><span>{{ text_no_results }}</span></td></tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row"><div class="col-sm-6 text-left">{{ pagination }}</div><div class="col-sm-6 text-right ccp-results-text">{{ results }}</div></div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('[data-ccp-select-all]').on('change', function(){ $('#form-codecart-review input[name="selected[]"]').prop('checked', this.checked); });
$('[data-ccp-review-bulk]').on('click', function(e){
  var action = $('select[name="bulk_action"]').val();
  if (action === 'delete' && !confirm('{{ text_confirm_delete|escape('js') }}')) { e.preventDefault(); }
});
//--></script>
{{ footer }}
