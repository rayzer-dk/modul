{{ header }}{{ column_left }}
<div id="content" class="ccp-admin-module ccp-admin-blog ccp-admin-blog-v861">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ categories }}" class="btn btn-info"><i class="fa fa-folder-open"></i> <span>{{ button_categories }}</span></a>
        <a href="{{ add }}" class="btn btn-primary"><i class="fa fa-plus"></i> <span>{{ button_add }}</span></a>
        <a href="{{ back }}" class="btn btn-default"><i class="fa fa-reply"></i> <span>{{ button_back }}</span></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible" role="alert"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible" role="status"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    <div class="ccp-blog-summary-grid">
      <div class="ccp-admin-stat"><i class="fa fa-newspaper-o"></i><div><strong>{{ summary.total }}</strong><span>{{ text_summary_total }}</span></div></div>
      <div class="ccp-admin-stat is-success"><i class="fa fa-check-circle"></i><div><strong>{{ summary.published }}</strong><span>{{ text_summary_published }}</span></div></div>
      <div class="ccp-admin-stat is-warning"><i class="fa fa-pencil-square-o"></i><div><strong>{{ summary.drafts }}</strong><span>{{ text_summary_drafts }}</span></div></div>
      <div class="ccp-admin-stat"><i class="fa fa-calendar"></i><div><strong>{{ summary.scheduled }}</strong><span>{{ text_summary_scheduled }}</span></div></div>
      <div class="ccp-admin-stat"><i class="fa fa-folder-open"></i><div><strong>{{ summary.categories }}</strong><span>{{ text_summary_categories }}</span></div></div>
    </div>

    <div class="panel panel-default ccp-compact-panel">
      <div class="panel-heading ccp-panel-heading-actions"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3><button type="button" class="btn btn-default btn-sm" data-toggle="collapse" data-target="#ccp-blog-tools"><i class="fa fa-wrench"></i> {{ button_tools }}</button></div>
      <div class="panel-body">
        <form action="index.php" method="get" id="form-codecart-blog-filter">
          <input type="hidden" name="route" value="extension/module/codecart_pro_blog" />
          <input type="hidden" name="user_token" value="{{ user_token }}" />
          <div class="ccp-filter-grid ccp-filter-grid-blog">
            <div><label for="input-filter-title">{{ entry_filter_title }}</label><input type="text" name="filter_title" value="{{ filter_title }}" id="input-filter-title" class="form-control" /></div>
            <div><label for="input-filter-category">{{ entry_filter_category }}</label><select name="filter_category_id" id="input-filter-category" class="form-control"><option value="0"></option>{% for category in categories_all %}<option value="{{ category.category_id }}"{% if filter_category_id == category.category_id %} selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div>
            <div><label for="input-filter-status">{{ entry_filter_status }}</label><select name="filter_status" id="input-filter-status" class="form-control"><option value=""></option><option value="1"{% if filter_status == '1' %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if filter_status == '0' %} selected{% endif %}>{{ text_disabled }}</option></select></div>
            <div><label for="input-filter-keyword">{{ entry_filter_keyword }}</label><input type="text" name="filter_keyword" value="{{ filter_keyword }}" id="input-filter-keyword" class="form-control" /></div>
            <div><label for="input-filter-date-from">{{ entry_filter_date_from }}</label><input type="date" name="filter_date_from" value="{{ filter_date_from }}" id="input-filter-date-from" class="form-control" /></div>
            <div><label for="input-filter-date-to">{{ entry_filter_date_to }}</label><input type="date" name="filter_date_to" value="{{ filter_date_to }}" id="input-filter-date-to" class="form-control" /></div>
            <div class="ccp-filter-buttons"><button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> {{ button_filter }}</button><a href="{{ clear_filter }}" class="btn btn-default"><i class="fa fa-eraser"></i> {{ button_clear_filter }}</a></div>
          </div>
        </form>
      </div>
    </div>

    <div class="collapse" id="ccp-blog-tools">
      <div class="panel panel-default ccp-tools-panel">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-wrench"></i> {{ text_tools }}</h3></div>
        <div class="panel-body ccp-blog-tools-grid">
          <div class="ccp-tool-card"><h4><i class="fa fa-file-code-o"></i> SEO</h4><div class="ccp-tool-actions"><a href="{{ seo_audit }}" class="btn btn-info"><i class="fa fa-search-plus"></i> {{ button_seo_audit }}</a><a href="{{ regenerate_seo }}" class="btn btn-warning"><i class="fa fa-refresh"></i> {{ button_regenerate_seo }}</a></div></div>
          <div class="ccp-tool-card"><h4><i class="fa fa-exchange"></i> CSV</h4><div class="ccp-tool-actions"><a href="{{ export }}" class="btn btn-success"><i class="fa fa-download"></i> {{ button_export }}</a><form action="{{ import }}" method="post" enctype="multipart/form-data" class="ccp-import-form"><input type="file" name="import_file" accept=".csv,text/csv" class="form-control" /><button type="submit" class="btn btn-success"><i class="fa fa-upload"></i> {{ button_import }}</button></form><p class="help-block">{{ help_import_articles }}</p></div></div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading ccp-panel-heading-actions">
        <h3 class="panel-title"><i class="fa fa-newspaper-o"></i> {{ text_list }}</h3>
        <div class="ccp-bulk-controls">
          <select name="bulk_action" form="form-codecart-blog" class="form-control"><option value="">{{ text_bulk_none }}</option><option value="enable">{{ text_bulk_enable }}</option><option value="disable">{{ text_bulk_disable }}</option><option value="assign_category">{{ text_bulk_assign_category }}</option><option value="regenerate_seo">{{ text_bulk_regenerate_seo }}</option></select>
          <select name="bulk_category_id" form="form-codecart-blog" class="form-control"><option value="0">{{ entry_bulk_category }}</option>{% for category in categories_all %}<option value="{{ category.category_id }}">{{ category.name }}</option>{% endfor %}</select>
          <button type="submit" form="form-codecart-blog" formaction="{{ bulk }}" class="btn btn-primary"><i class="fa fa-check"></i> {{ button_bulk_apply }}</button>
          <button type="submit" form="form-codecart-blog" formaction="{{ delete }}" class="btn btn-danger" data-ccp-blog-delete><i class="fa fa-trash-o"></i> {{ button_delete }}</button>
        </div>
      </div>
      <div class="panel-body">
        <form method="post" enctype="multipart/form-data" id="form-codecart-blog">
          <div class="table-responsive" role="region" tabindex="0" aria-label="{{ heading_title|striptags|e('html_attr') }}">
            <table class="table table-bordered table-hover ccp-blog-table">
              <thead><tr><td class="text-center" style="width:42px;"><input type="checkbox" data-ccp-select-all /></td><td>{{ column_image }}</td><td>{{ column_title }}</td><td>{{ column_categories }}</td><td>{{ column_status }}</td><td>{{ entry_date_available }}</td><td>{{ column_sort_order }}</td><td class="text-right">{{ column_action }}</td></tr></thead>
              <tbody>{% if articles %}{% for article in articles %}<tr><td class="text-center"><input type="checkbox" name="selected[]" value="{{ article.article_id }}" /></td><td><img src="{{ article.thumb }}" alt="" class="img-thumbnail ccp-blog-list-thumb" /></td><td><strong>{{ article.title }}</strong><div class="ccp-muted-line">#{{ article.article_id }} · {{ article.keyword }}</div></td><td>{{ article.categories ? article.categories : '—' }}</td><td>{% if article.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-default">{{ text_disabled }}</span>{% endif %}</td><td>{{ article.date_available }}</td><td><input type="number" name="sort_order[{{ article.article_id }}]" value="{{ article.sort_order }}" class="form-control input-sm ccp-sort-input" /></td><td class="text-right"><a href="{{ article.view }}" target="_blank" rel="noopener" class="btn btn-info btn-sm" aria-label="{{ button_view }}" title="{{ button_view }}"><i class="fa fa-external-link" aria-hidden="true"></i></a><a href="{{ article.edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i> {{ button_edit }}</a></td></tr>{% endfor %}{% else %}<tr><td colspan="8" class="text-center ccp-empty-state"><i class="fa fa-newspaper-o"></i><span>{{ text_no_results }}</span></td></tr>{% endif %}</tbody>
            </table>
          </div>
        </form>
        <div class="row"><div class="col-sm-6 text-left">{{ pagination }}</div><div class="col-sm-6 text-right ccp-results-text">{{ results }}</div></div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('[data-ccp-select-all]').on('change', function(){ $('#form-codecart-blog input[name="selected[]"]').prop('checked', this.checked); });
$('[data-ccp-blog-delete]').on('click', function(e){ if (!confirm('{{ text_confirm|escape('js') }}')) { e.preventDefault(); } });
//--></script>
{{ footer }}
