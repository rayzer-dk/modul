{{ header }}{{ column_left }}
<div id="content" class="ccp-admin-module ccp-admin-blog">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ regenerate_seo }}" data-toggle="tooltip" title="{{ button_regenerate_seo }}" class="btn btn-warning"><i class="fa fa-refresh"></i> <span>{{ button_regenerate_seo }}</span></a>
        <a href="{{ categories }}" data-toggle="tooltip" title="{{ button_categories }}" class="btn btn-default"><i class="fa fa-folder-open"></i> <span>{{ button_categories }}</span></a>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_back }}" class="btn btn-default"><i class="fa fa-reply"></i> <span>{{ button_back|default(button_cancel) }}</span></a>
      </div>
      <h1>{{ heading_seo_audit }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible" role="alert"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible" role="status"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_audit_limited|replace({'%s': audit_limit}) }}</div>


    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-magic"></i> {{ text_autofix_panel }}</h3></div>
      <div class="panel-body">
        <form action="{{ autofix_seo }}" method="post" class="form-horizontal">
          <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_autofix_warning }}</div>
          <div class="row">
            <div class="col-sm-4"><label class="checkbox-inline"><input type="checkbox" name="autofix_articles" value="1" checked="checked"> {{ entry_autofix_articles }}</label></div>
            <div class="col-sm-4"><label class="checkbox-inline"><input type="checkbox" name="autofix_categories" value="1" checked="checked"> {{ entry_autofix_categories }}</label></div>
            <div class="col-sm-4"><label class="checkbox-inline"><input type="checkbox" name="autofix_meta" value="1" checked="checked"> {{ entry_autofix_meta }}</label></div>
          </div>
          <div class="row" style="margin-top:10px;">
            <div class="col-sm-4"><label class="checkbox-inline"><input type="checkbox" name="autofix_keywords" value="1" checked="checked"> {{ entry_autofix_keywords }}</label></div>
            <div class="col-sm-4"><label class="checkbox-inline"><input type="checkbox" name="autofix_duplicates" value="1" checked="checked"> {{ entry_autofix_duplicates }}</label></div>
            <div class="col-sm-4"><label class="checkbox-inline"><input type="checkbox" name="autofix_sync_urls" value="1" checked="checked"> {{ entry_autofix_sync_urls }}</label></div>
          </div>
          <div class="text-right" style="margin-top:15px;"><button type="submit" class="btn btn-success"><i class="fa fa-magic"></i> {{ button_autofix_seo }}</button></div>
        </form>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-4"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-dashboard"></i> {{ text_audit_summary }}</h3></div><div class="panel-body"><h2>{{ total_summary.total }}</h2><span class="label label-danger">{{ text_audit_critical }}: {{ total_summary.critical }}</span> <span class="label label-warning">{{ text_audit_warning }}: {{ total_summary.warning }}</span> <span class="label label-info">{{ text_audit_info }}: {{ total_summary.info }}</span></div></div></div>
      <div class="col-sm-4"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-newspaper-o"></i> {{ text_audit_articles }}</h3></div><div class="panel-body"><h2>{{ article_summary.total }}</h2><span class="label label-danger">{{ text_audit_critical }}: {{ article_summary.critical }}</span> <span class="label label-warning">{{ text_audit_warning }}: {{ article_summary.warning }}</span> <span class="label label-info">{{ text_audit_info }}: {{ article_summary.info }}</span></div></div></div>
      <div class="col-sm-4"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-folder-open"></i> {{ text_audit_categories }}</h3></div><div class="panel-body"><h2>{{ category_summary.total }}</h2><span class="label label-danger">{{ text_audit_critical }}: {{ category_summary.critical }}</span> <span class="label label-warning">{{ text_audit_warning }}: {{ category_summary.warning }}</span> <span class="label label-info">{{ text_audit_info }}: {{ category_summary.info }}</span></div></div></div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-newspaper-o"></i> {{ text_audit_articles }}</h3></div>
      <div class="panel-body">
        <div class="table-responsive" role="region" tabindex="0" aria-label="{{ heading_title|striptags|e('html_attr') }}">
          <table class="table table-bordered table-hover">
            <thead><tr><td>{{ text_audit_entity }}</td><td>{{ text_audit_language }}</td><td>{{ text_audit_field }}</td><td>{{ text_audit_severity }}</td><td>{{ text_audit_problem }}</td><td class="text-right">{{ text_audit_action }}</td></tr></thead>
            <tbody>{% if article_issues %}{% for issue in article_issues %}<tr><td>{{ text_audit_article }} #{{ issue.entity_id }}</td><td>{{ issue.language }}</td><td>{{ issue.field }}</td><td>{% if issue.severity == 'critical' %}<span class="label label-danger">{{ text_audit_critical }}</span>{% elseif issue.severity == 'warning' %}<span class="label label-warning">{{ text_audit_warning }}</span>{% else %}<span class="label label-info">{{ text_audit_info }}</span>{% endif %}</td><td>{{ issue.message }}</td><td class="text-right"><a href="{{ issue.edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i> {{ button_edit }}</a></td></tr>{% endfor %}{% else %}<tr><td colspan="6" class="text-center">{{ text_audit_no_issues }}</td></tr>{% endif %}</tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-folder-open"></i> {{ text_audit_categories }}</h3></div>
      <div class="panel-body">
        <div class="table-responsive" role="region" tabindex="0" aria-label="{{ heading_title|striptags|e('html_attr') }}">
          <table class="table table-bordered table-hover">
            <thead><tr><td>{{ text_audit_entity }}</td><td>{{ text_audit_language }}</td><td>{{ text_audit_field }}</td><td>{{ text_audit_severity }}</td><td>{{ text_audit_problem }}</td><td class="text-right">{{ text_audit_action }}</td></tr></thead>
            <tbody>{% if category_issues %}{% for issue in category_issues %}<tr><td>{{ text_audit_category }} #{{ issue.entity_id }}</td><td>{{ issue.language }}</td><td>{{ issue.field }}</td><td>{% if issue.severity == 'critical' %}<span class="label label-danger">{{ text_audit_critical }}</span>{% elseif issue.severity == 'warning' %}<span class="label label-warning">{{ text_audit_warning }}</span>{% else %}<span class="label label-info">{{ text_audit_info }}</span>{% endif %}</td><td>{{ issue.message }}</td><td class="text-right"><a href="{{ issue.edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i> {{ button_edit }}</a></td></tr>{% endfor %}{% else %}<tr><td colspan="6" class="text-center">{{ text_audit_no_issues }}</td></tr>{% endif %}</tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
