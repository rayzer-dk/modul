{{ header }}{{ column_left }}
<div id="content" class="ccp-admin-module ccp-admin-blog ccp-admin-blog-v861">
  <div class="page-header"><div class="container-fluid"><div class="pull-right">{% if view %}<a href="{{ view }}" target="_blank" rel="noopener" class="btn btn-info"><i class="fa fa-external-link"></i> <span>{{ button_open_category }}</span></a>{% endif %}<button type="submit" form="form-codecart-blog-category" class="btn btn-primary"><i class="fa fa-save"></i> <span>{{ button_save }}</span></button><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> <span>{{ button_cancel }}</span></a></div><h1>{{ heading_category_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid"><form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-codecart-blog-category" class="form-horizontal"><div class="panel panel-default ccp-blog-editor-panel"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-folder-open"></i> {{ text_category_form }}</h3></div><div class="panel-body">
    <ul class="nav nav-tabs ccp-blog-editor-tabs"><li class="active"><a href="#tab-category-content" data-toggle="tab"><i class="fa fa-align-left"></i> {{ text_category_content }}</a></li><li><a href="#tab-category-seo" data-toggle="tab"><i class="fa fa-search"></i> {{ text_category_seo }}</a></li><li><a href="#tab-category-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ text_category_settings }}</a></li><li><a href="#tab-category-relations" data-toggle="tab"><i class="fa fa-link"></i> {{ text_category_relations }}</a></li></ul>
    <div class="tab-content ccp-blog-editor-content">
      <div class="tab-pane active" id="tab-category-content"><ul class="nav nav-tabs ccp-language-tabs">{% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#category-content-language-{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" onerror="this.style.display='none'" /> {{ language.name }}</a></li>{% endfor %}</ul><div class="tab-content ccp-language-content">{% for language in languages %}<div class="tab-pane{% if loop.first %} active{% endif %}" id="category-content-language-{{ language.language_id }}"><div class="form-group required"><label class="col-sm-2 control-label">{{ entry_name }}</label><div class="col-sm-10"><input type="text" name="description[{{ language.language_id }}][name]" value="{{ descriptions[language.language_id].name is defined ? descriptions[language.language_id].name : '' }}" class="form-control" /></div></div><div class="form-group ccp-editor-field"><label class="col-sm-2 control-label">{{ entry_description }}</label><div class="col-sm-10"><textarea name="description[{{ language.language_id }}][description]" rows="12" class="form-control" data-toggle="summernote" data-lang="{{ summernote }}">{{ descriptions[language.language_id].description is defined ? descriptions[language.language_id].description : '' }}</textarea></div></div><div class="form-group ccp-editor-field"><label class="col-sm-2 control-label">{{ entry_seo_text }}</label><div class="col-sm-10"><textarea name="description[{{ language.language_id }}][seo_text]" rows="6" class="form-control">{{ descriptions[language.language_id].seo_text is defined ? descriptions[language.language_id].seo_text : '' }}</textarea></div></div></div>{% endfor %}</div></div>
      <div class="tab-pane" id="tab-category-seo"><ul class="nav nav-tabs ccp-language-tabs">{% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#category-seo-language-{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" onerror="this.style.display='none'" /> {{ language.name }}</a></li>{% endfor %}</ul><div class="tab-content ccp-language-content">{% for language in languages %}<div class="tab-pane{% if loop.first %} active{% endif %}" id="category-seo-language-{{ language.language_id }}"><div class="ccp-two-column-fields"><div class="form-group"><label class="control-label">{{ entry_meta_title }}</label><input type="text" name="description[{{ language.language_id }}][meta_title]" value="{{ descriptions[language.language_id].meta_title is defined ? descriptions[language.language_id].meta_title : '' }}" class="form-control" /></div><div class="form-group"><label class="control-label">{{ entry_language_keyword }}</label><input type="text" name="description[{{ language.language_id }}][keyword]" value="{{ descriptions[language.language_id].keyword is defined ? descriptions[language.language_id].keyword : '' }}" class="form-control" /></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_description }}</label><div class="col-sm-10"><textarea name="description[{{ language.language_id }}][meta_description]" rows="4" class="form-control">{{ descriptions[language.language_id].meta_description is defined ? descriptions[language.language_id].meta_description : '' }}</textarea></div></div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_keyword }}</label><div class="col-sm-10"><input type="text" name="description[{{ language.language_id }}][meta_keyword]" value="{{ descriptions[language.language_id].meta_keyword is defined ? descriptions[language.language_id].meta_keyword : '' }}" class="form-control" /></div></div></div>{% endfor %}</div><div class="form-group"><label class="col-sm-2 control-label">{{ entry_keyword }}</label><div class="col-sm-10"><input type="text" name="category[keyword]" value="{{ category.keyword }}" class="form-control" /></div></div></div>
      <div class="tab-pane" id="tab-category-settings"><div class="ccp-publication-grid"><div class="ccp-publication-main"><div class="form-group ccp-image-field"><label class="col-sm-2 control-label">{{ entry_image }}</label><div class="col-sm-10"><div class="ccp-standard-image-picker"><a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><div class="ccp-image-picker-controls"><input type="text" name="category[image]" value="{{ category.image }}" id="input-image" class="form-control" placeholder="catalog/example.jpg" /><div class="ccp-image-picker-buttons"><button type="button" class="btn btn-primary" onclick="$('#thumb-image').trigger('click');"><i class="fa fa-image"></i> <span>{{ button_select_image }}</span></button><button type="button" class="btn btn-default" onclick="$('#thumb-image img').attr('src', '{{ placeholder|escape('js') }}'); $('#input-image').val('');"><i class="fa fa-times"></i> <span>{{ button_clear_image }}</span></button></div></div></div></div></div></div><div class="ccp-publication-side"><div class="form-group"><label class="control-label">{{ entry_status }}</label><select name="category[status]" class="form-control"><option value="1"{% if category.status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not category.status %} selected{% endif %}>{{ text_disabled }}</option></select></div><div class="form-group"><label class="control-label">{{ entry_sort_order }}</label><input type="number" name="category[sort_order]" value="{{ category.sort_order }}" class="form-control" /></div></div></div></div>
      <div class="tab-pane" id="tab-category-relations"><div class="ccp-tab-intro"><i class="fa fa-info-circle"></i> {{ help_related_store_categories }}</div><div class="form-group ccp-relation-field"><label class="control-label">{{ entry_related_store_categories }}</label><input type="text" id="input-store-category" value="" class="form-control" placeholder="{{ entry_related_store_categories }}" /><input type="hidden" name="related_store_category_ids" value="{% for store_category in store_categories %}{{ store_category.category_id }}{% if not loop.last %},{% endif %}{% endfor %}" id="input-store-category-ids" /><div id="store-category-list" class="ccp-selected-list">{% for store_category in store_categories %}<div id="store-category{{ store_category.category_id }}"><button type="button" class="btn btn-danger btn-xs" aria-label="{{ button_remove }}" title="{{ button_remove }}"><i class="fa fa-minus" aria-hidden="true"></i></button><span>{{ store_category.name }}</span><input type="hidden" value="{{ store_category.category_id }}" /></div>{% endfor %}</div></div></div>
    </div>
  </div></div></form></div>
</div>
<script type="text/javascript"><!--
function ccpEscapeHtml(value){return $('<div>').text(value == null ? '' : String(value)).html();}
function ccpSyncStoreCategoryIds(){var ids=[];$('#store-category-list input[type="hidden"]').each(function(){ids.push($(this).val());});$('#input-store-category-ids').val(ids.join(','));}
$('#input-store-category').autocomplete({source:function(request,response){$.ajax({url:'index.php?route=extension/module/codecart_pro_blog/autocompleteStoreCategory&user_token={{ user_token }}&filter_name='+encodeURIComponent(request),dataType:'json',success:function(json){response($.map(json,function(item){return {label:item.name,value:item.category_id};}));}});},select:function(item){$('#input-store-category').val('');$('#store-category'+item.value).remove();$('#store-category-list').append('<div id="store-category'+item.value+'"><button type="button" class="btn btn-danger btn-xs" aria-label="{{ button_remove }}" title="{{ button_remove }}"><i class="fa fa-minus" aria-hidden="true"></i></button><span>'+ccpEscapeHtml(item.label)+'</span><input type="hidden" value="'+item.value+'" /></div>');ccpSyncStoreCategoryIds();}});
$('#store-category-list').on('click','.btn-danger',function(){$(this).closest('div[id]').remove();ccpSyncStoreCategoryIds();});
//--></script>
{{ footer }}
