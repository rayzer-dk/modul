  </div>
</div>
{% macro select(label, name, value, help, yes, no) %}<div class="form-group"><label class="col-sm-2 control-label">{{ label }}</label><div class="col-sm-10"><select name="{{ name }}" class="form-control"><option value="1"{% if value %} selected{% endif %}>{{ yes }}</option><option value="0"{% if not value %} selected{% endif %}>{{ no }}</option></select>{% if help %}<p class="help-block">{{ help }}</p>{% endif %}</div></div>{% endmacro %}
{% macro number(label, name, value, help, unit) %}<div class="form-group"><label class="col-sm-2 control-label">{{ label }}</label><div class="col-sm-10">{% if unit %}<div class="input-group"><input type="number" name="{{ name }}" value="{{ value }}" class="form-control" /><span class="input-group-addon">{{ unit }}</span></div>{% else %}<input type="number" name="{{ name }}" value="{{ value }}" class="form-control" />{% endif %}{% if help %}<p class="help-block">{{ help }}</p>{% endif %}</div></div>{% endmacro %}
{% macro color(label, name, value, help) %}<div class="form-group"><label class="col-sm-2 control-label">{{ label }}</label><div class="col-sm-10"><div class="ccp-color"><input type="color" value="{{ value }}" class="form-control ccp-color-native" data-color-target="{{ name }}" /><input type="text" name="{{ name }}" value="{{ value }}" class="form-control ccp-color-text" id="{{ name }}" /></div>{% if help %}<p class="help-block">{{ help }}</p>{% endif %}</div></div>{% endmacro %}
{% macro size(label, prefix, width, height, width_label, height_label) %}<div class="ccp-size-card"><div class="ccp-size-title"><i class="fa fa-picture-o"></i><span>{{ label }}</span></div><div class="ccp-size-fields"><label class="ccp-size-field"><span>{{ width_label }}</span><div class="input-group"><input type="number" name="{{ prefix }}_width" value="{{ width }}" class="form-control" min="1" /><span class="input-group-addon">px</span></div></label><label class="ccp-size-field"><span>{{ height_label }}</span><div class="input-group"><input type="number" name="{{ prefix }}_height" value="{{ height }}" class="form-control" min="1" /><span class="input-group-addon">px</span></div></label></div></div>{% endmacro %}
{% macro codearea(label, name, value, type, expand_label) %}<div class="form-group ccp-codearea-row"><label class="col-sm-2 control-label">{{ label }}</label><div class="col-sm-10"><div class="ccp-codearea-head"><span>{{ type }}</span><button type="button" class="btn btn-default btn-xs ccp-expand-code">{{ expand_label }}</button></div><textarea name="{{ name }}" rows="7" class="form-control code" spellcheck="false">{{ value }}</textarea></div></div>{% endmacro %}





<!-- CodeCart PRO Theme v8.7.7: structured, responsive admin interface -->


<script>
(function(){
  'use strict';
  if (window.__ccpThemeAdmin856Ready) return;
  window.__ccpThemeAdmin856Ready = true;

  var root = document.querySelector('.ccp-admin-v626');
  if (!root) return;
  var body = document.body;


  var textExpand = {{ text_expand|json_encode }};
  var textCollapse = {{ text_collapse|json_encode }};
  var textNoMatches = {{ text_no_matches|json_encode }};
  var filemanagerUrl = {{ ccp_filemanager_url|json_encode }};
  var categoryAutocompleteUrl = {{ ccp_category_autocomplete_url|json_encode }};
  var productAutocompleteUrl = {{ ccp_product_autocomplete_url|json_encode }};
  var informationAutocompleteUrl = {{ ccp_information_autocomplete_url|json_encode }};

  function cleanText(value) {
    return String(value || '').replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
  }

  function normalize(value) {
    value = cleanText(value).toLowerCase();
    value = value.replace(/@/g, ' mail ');
    value = value.replace(/[_\-.\/\\]+/g, ' ');
    value = value.replace(/[ё]/g, 'е').replace(/[і]/g, 'и').replace(/[ї]/g, 'и').replace(/[є]/g, 'е').replace(/[ґ]/g, 'г');
    value = value.replace(/[^a-z0-9а-яіїєґ]+/g, ' ');
    return cleanText(value);
  }

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function(ch) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch];
    });
  }

  function closest(el, selector) {
    return el && el.closest ? el.closest(selector) : null;
  }

  function showTab(link) {
    if (!link) return;
    if (window.jQuery && jQuery.fn && jQuery.fn.tab) {
      jQuery(link).tab('show');
    } else {
      link.click();
    }
  }

  function cleanModalState() {
    window.setTimeout(function(){
      if (!document.querySelector('.modal.in,.modal.show')) {
        body.classList.remove('modal-open');
        body.style.removeProperty('padding-right');
        Array.prototype.forEach.call(document.querySelectorAll('.modal-backdrop'), function(backdrop){
          if (backdrop && backdrop.parentNode) backdrop.parentNode.removeChild(backdrop);
        });
      }
    }, 80);
  }

  function initSettingsMenuToggle() {
    var toggle = root.querySelector('[data-ccp-theme-menu-toggle]');
    if (!toggle || toggle.getAttribute('data-ccp-ready') === '1') return;
    toggle.setAttribute('data-ccp-ready', '1');
    var mobile = window.matchMedia('(max-width: 767px)');
    var desktopLabel = toggle.getAttribute('aria-label');
    root.classList.add('ccp-mobile-navigation-ready');
    function updateIcon() {
      var icon = toggle.querySelector('.fa');
      var collapsed = mobile.matches ? !root.classList.contains('ccp-mobile-navigation-open') : root.classList.contains('ccp-theme-settings-menu-collapsed');
      if (icon) icon.className = mobile.matches ? (collapsed ? 'fa fa-bars' : 'fa fa-times') : (collapsed ? 'fa fa-angle-right' : 'fa fa-angle-left');
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      toggle.setAttribute('aria-controls', 'ccp-theme-navigation');
      var label = mobile.matches ? root.getAttribute('data-ccp-settings-label') : desktopLabel;
      toggle.setAttribute('aria-label', label);
      toggle.setAttribute('title', label);
    }
    toggle.addEventListener('click', function(e){
      e.preventDefault();
      if (mobile.matches) {
        root.classList.toggle('ccp-mobile-navigation-open');
      } else {
        root.classList.toggle('ccp-theme-settings-menu-collapsed');
        try { localStorage.setItem('ccp_theme_settings_menu_collapsed', root.classList.contains('ccp-theme-settings-menu-collapsed') ? '1' : '0'); } catch(err) {}
      }
      updateIcon();
    });
    root.addEventListener('click', function(event){
      var link = closest(event.target, '.ccp-tabs a');
      if (link && mobile.matches) {
        root.classList.remove('ccp-mobile-navigation-open');
        updateIcon();
        var pane = root.querySelector(link.getAttribute('href'));
        if (pane) { pane.setAttribute('tabindex', '-1'); window.setTimeout(function(){ pane.focus({preventScroll:true}); }, 0); }
      }
    });
    root.addEventListener('keydown', function(event){
      if (event.key === 'Escape' && mobile.matches && root.classList.contains('ccp-mobile-navigation-open')) {
        root.classList.remove('ccp-mobile-navigation-open'); updateIcon(); toggle.focus();
      }
    });
    if (mobile.addEventListener) mobile.addEventListener('change', updateIcon);
    try { if (localStorage.getItem('ccp_theme_settings_menu_collapsed') === '1') root.classList.add('ccp-theme-settings-menu-collapsed'); } catch(err) {}
    updateIcon();
  }

  function initCodeareas() {
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-expand-code'), function(button){
      if (button.getAttribute('data-ccp-ready') === '1') return;
      button.setAttribute('data-ccp-ready', '1');
      button.addEventListener('click', function(e){
        e.preventDefault();
        var row = closest(button, '.ccp-codearea-row');
        if (!row) return;
        row.classList.toggle('ccp-expanded');
        button.textContent = row.classList.contains('ccp-expanded') ? textCollapse : textExpand;
      });
    });
  }

  function initColors() {
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-color-native'), function(picker){
      if (picker.getAttribute('data-ccp-ready') === '1') return;
      picker.setAttribute('data-ccp-ready', '1');
      var target = document.getElementById(picker.getAttribute('data-color-target'));
      if (!target) return;
      picker.addEventListener('input', function(){ target.value = picker.value; });
      target.addEventListener('input', function(){ if (/^#[0-9a-fA-F]{6}$/.test(target.value)) picker.value = target.value; });
    });
  }

  function buildInnerTabs(selector) {
    var pane = root.querySelector(selector);
    if (!pane || pane.getAttribute('data-ccp-inner-tabs') === '1') return;
    var fieldsets = [];
    Array.prototype.forEach.call(pane.children, function(child){
      if (child.tagName && child.tagName.toLowerCase() === 'fieldset') {
        fieldsets.push(child);
      } else if (child.classList && child.classList.contains('row')) {
        Array.prototype.forEach.call(child.children, function(col){
          Array.prototype.forEach.call(col.children || [], function(grand){
            if (grand.tagName && grand.tagName.toLowerCase() === 'fieldset') fieldsets.push(grand);
          });
        });
      }
    });
    if (fieldsets.length < 2) return;
    pane.setAttribute('data-ccp-inner-tabs', '1');
    var icons = ['fa-cog','fa-bars','fa-paint-brush','fa-shopping-cart','fa-mobile','fa-search','fa-bolt','fa-code','fa-info-circle'];
    var nav = document.createElement('ul');
    nav.className = 'nav nav-tabs ccp-inner-tabs';
    var content = document.createElement('div');
    content.className = 'tab-content ccp-inner-content';
    fieldsets.forEach(function(fieldset, index){
      var legend = fieldset.querySelector('legend');
      var title = legend ? cleanText(legend.textContent) : ('Tab ' + (index + 1));
      var id = selector.replace('#','') + '-inner-' + index;
      var li = document.createElement('li');
      if (index === 0) li.className = 'active';
      var a = document.createElement('a');
      a.href = '#' + id;
      a.setAttribute('data-toggle', 'tab');
      a.innerHTML = '<i class="fa ' + icons[index % icons.length] + '"></i> ' + escapeHtml(title);
      li.appendChild(a);
      nav.appendChild(li);
      var wrap = document.createElement('div');
      wrap.className = 'tab-pane' + (index === 0 ? ' active' : '');
      wrap.id = id;
      if (legend && legend.parentNode) legend.parentNode.removeChild(legend);
      wrap.appendChild(fieldset);
      content.appendChild(wrap);
    });
    Array.prototype.forEach.call(pane.children, function(child){
      if (child.classList && child.classList.contains('row') && !cleanText(child.textContent) && !child.querySelector('input,select,textarea,button,a,img')) {
        child.parentNode.removeChild(child);
      }
    });
    pane.insertBefore(content, pane.firstChild);
    pane.insertBefore(nav, content);
  }

  function initInnerTabs() {
    ['#tab-home-builder','#tab-storefront-depth','#tab-mega-menu','#tab-commerce','#tab-product-ux','#tab-seo-content','#tab-release-tools'].forEach(buildInnerTabs);
  }

  function isWideSetting(group, container) {
    if (!group) return true;
    if (group.classList.contains('ccp-codearea-row')) return true;
    if (group.querySelector('textarea,.note-editor,.summernote,.CodeMirror,table,.table,.alert,.ccp-size-grid,.ccp-link-helper,.ccp-icon-picker,.nav-tabs:not(.ccp-tabs),.tab-content,.well,.ccp-repeater-card')) return true;
    if (group.querySelectorAll('input,select,textarea').length > 2) return true;
    if (container && container.classList && container.classList.contains('ccp-repeater-card') && group.querySelector('.ccp-media-picker')) return false;
    return false;
  }

  function classifySetting(group, container) {
    group.classList.remove('ccp-form-wide','ccp-setting-card','ccp-setting-wide');
    group.classList.add('ccp-setting-card');
    if (isWideSetting(group, container)) group.classList.add('ccp-setting-wide');
  }

  function wrapSettingRuns(container) {
    if (!container || container.getAttribute('data-ccp-layout-ready') === '1') return;
    var directGroups = Array.prototype.filter.call(container.children || [], function(child){
      return child.classList && child.classList.contains('form-group');
    });
    if (!directGroups.length) return;

    directGroups.forEach(function(group){ classifySetting(group, container); });

    var run = [];
    function flush() {
      if (!run.length) return;
      var grid = document.createElement('div');
      grid.className = 'ccp-settings-grid' + (run.length === 1 ? ' is-single' : '');
      run[0].parentNode.insertBefore(grid, run[0]);
      run.forEach(function(group){ grid.appendChild(group); });
      run = [];
    }

    directGroups.forEach(function(group){
      if (group.classList.contains('ccp-setting-wide')) {
        flush();
      } else {
        run.push(group);
      }
    });
    flush();
    container.setAttribute('data-ccp-layout-ready', '1');
  }

  function buildStructuredLayout() {
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-settings-grid'), function(grid){
      var parent = grid.parentNode;
      if (!parent) return;
      while (grid.firstChild) parent.insertBefore(grid.firstChild, grid);
      parent.removeChild(grid);
    });

    Array.prototype.forEach.call(root.querySelectorAll('.form-group'), function(group){
      classifySetting(group, group.parentNode);
    });

    Array.prototype.forEach.call(root.querySelectorAll('fieldset,.well'), function(container){
      container.classList.remove('ccp-auto-grid');
    });
  }

  function initRepeaterCards() {
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-repeater-card'), function(card, index){
      if (card.getAttribute('data-ccp-repeater-ready') === '1') return;
      card.setAttribute('data-ccp-repeater-ready', '1');
      var heading = card.querySelector(':scope > strong');
      if (!heading) return;
      heading.classList.add('ccp-repeater-title');
      var bodyWrap = document.createElement('div');
      bodyWrap.className = 'ccp-repeater-body';
      var next = heading.nextSibling;
      while (next) {
        var current = next;
        next = next.nextSibling;
        bodyWrap.appendChild(current);
      }
      card.appendChild(bodyWrap);
      var toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'btn btn-default btn-xs ccp-repeater-toggle';
      toggle.setAttribute('aria-expanded', index === 0 ? 'true' : 'false');
      toggle.innerHTML = '<i class="fa fa-chevron-down"></i>';
      heading.appendChild(toggle);
      var siblingCards = Array.prototype.filter.call(card.parentNode.children || [], function(item){ return item.classList && item.classList.contains('ccp-repeater-card'); });
      var siblingIndex = siblingCards.indexOf(card);
      if (siblingIndex > 0) card.classList.add('is-collapsed');
      function render() {
        var collapsed = card.classList.contains('is-collapsed');
        toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        var icon = toggle.querySelector('.fa');
        if (icon) icon.className = collapsed ? 'fa fa-chevron-right' : 'fa fa-chevron-down';
      }
      toggle.addEventListener('click', function(event){
        event.preventDefault();
        card.classList.toggle('is-collapsed');
        render();
      });
      render();
    });
  }

  function initSectionIntros() {
    var settingsLabel = root.getAttribute('data-ccp-settings-label') || '';
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-tab-content > .tab-pane'), function(pane){
      if (!pane.id || pane.id === 'tab-general' || pane.id === 'tab-diagnostics' || pane.id === 'tab-about' || pane.querySelector(':scope > .ccp-section-intro')) return;
      var link = root.querySelector('.ccp-tabs a[href="#' + pane.id + '"]');
      if (!link) return;
      var icon = link.querySelector('.fa');
      var title = cleanText(link.textContent);
      var count = pane.querySelectorAll('.form-group').length;
      var intro = document.createElement('div');
      intro.className = 'ccp-section-intro';
      intro.innerHTML = '<div class="ccp-section-intro-icon"><i class="fa ' + (icon ? icon.className.replace(/^fa\s+/, '') : 'fa-cog') + '"></i></div><div class="ccp-section-intro-copy"><h2>' + escapeHtml(title) + '</h2><p>' + count + ' ' + escapeHtml(settingsLabel) + '</p></div>';
      pane.insertBefore(intro, pane.firstChild);
    });
  }

  function normalizeTabGroups() {
    var active = root.querySelector('.ccp-tabs > li.active');
    var activeGroup = active && active.closest ? active.closest('.ccp-tab-group') : null;
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-tab-group'), function(group){
      group.classList.toggle('is-open', group === activeGroup);
    });
  }

  function updateMediaPreview(picker) {
    if (!picker) return;
    var input = picker.querySelector('input[type="text"]');
    var preview = picker.parentNode ? picker.parentNode.querySelector('.ccp-media-preview') : null;
    if (!input || !preview) return;
    var value = String(input.value || '').replace(/^image\//, '').replace(/^\/+/, '');
    var image = preview.querySelector('img');
    if (!value) {
      preview.classList.add('is-empty');
      if (image) image.removeAttribute('src');
      return;
    }
    preview.classList.remove('is-empty');
    if (image) image.src = '../image/' + value;
  }

  function enhanceMediaPickers() {
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-media-picker'), function(picker){
      if (picker.getAttribute('data-ccp-preview-ready') === '1') return;
      picker.setAttribute('data-ccp-preview-ready', '1');
      var mediaGroup = picker.closest ? picker.closest('.form-group') : null;
      if (mediaGroup) mediaGroup.classList.add('ccp-media-setting');
      var preview = document.createElement('div');
      preview.className = 'ccp-media-preview is-empty';
      preview.innerHTML = '<img alt="" loading="lazy"><span><i class="fa fa-picture-o"></i></span>';
      picker.parentNode.insertBefore(preview, picker);
      var input = picker.querySelector('input[type="text"]');
      if (input) input.addEventListener('change', function(){ updateMediaPreview(picker); });
      updateMediaPreview(picker);
    });
    if (window.jQuery) {
      jQuery(document).on('hidden.bs.modal', '#modal-image', function(){
        window.setTimeout(function(){ Array.prototype.forEach.call(root.querySelectorAll('.ccp-media-picker'), updateMediaPreview); }, 80);
      });
    }
  }

  function resetLeftMenu() {
    var menu = root.querySelector('[data-ccp-tab-menu]');
    if (!menu) return;
    Array.prototype.forEach.call(menu.querySelectorAll('li,.ccp-tab-group'), function(item){ item.style.display = ''; });
  }

  function initTabGroups() {
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-tab-group-title'), function(button){
      if (button.getAttribute('data-ccp-ready') === '1') return;
      button.setAttribute('data-ccp-ready', '1');
      button.addEventListener('click', function(e){
        e.preventDefault();
        var group = closest(button, '.ccp-tab-group');
        if (group) group.classList.toggle('is-open');
      });
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-ccp-tab-menu] a[data-toggle="tab"]'), function(link){
      if (link.getAttribute('data-ccp-tab-ready') === '1') return;
      link.setAttribute('data-ccp-tab-ready', '1');
      link.addEventListener('click', function(){
        var id = cleanTabId(link.getAttribute('href'));
        var hidden = document.getElementById('ccp-active-tab');
        if (hidden) hidden.value = id;
        try { localStorage.setItem('ccp_theme_active_tab', id); } catch(err) {}
        var group = closest(link, '.ccp-tab-group');
        if (group) group.classList.add('is-open');
        window.setTimeout(buildStructuredLayout, 80);
      });
    });
  }

  function cleanTabId(value) {
    value = String(value || '').replace(/^#/, '');
    return /^[a-zA-Z0-9_-]+$/.test(value) ? value : '';
  }

  function restoreActiveTab() {
    var serverTab = cleanTabId({{ ccp_active_tab|default('')|json_encode }});
    var storedTab = '';
    try { storedTab = cleanTabId(localStorage.getItem('ccp_theme_active_tab')); } catch(err) {}
    var id = serverTab || storedTab;
    if (!id) return;
    var link = root.querySelector('.ccp-tabs a[href="#' + id + '"]');
    if (!link) return;
    var group = closest(link, '.ccp-tab-group');
    if (group) group.classList.add('is-open');
    showTab(link);
    var hidden = document.getElementById('ccp-active-tab');
    if (hidden) hidden.value = id;
  }

  function initScrollSave() {
    var form = document.getElementById('form-codecart-pro');
    if (form && form.getAttribute('data-ccp-scroll-ready') !== '1') {
      form.setAttribute('data-ccp-scroll-ready', '1');
      form.addEventListener('submit', function(){
        var active = root.querySelector('.ccp-tabs li.active a[href^="#"]');
        var activeId = active ? cleanTabId(active.getAttribute('href')) : '';
        var tabInput = document.getElementById('ccp-active-tab');
        var scrollInput = document.getElementById('ccp-scroll-top');
        if (tabInput && activeId) tabInput.value = activeId;
        if (scrollInput) scrollInput.value = String(window.pageYOffset || document.documentElement.scrollTop || 0);
      });
    }
    var scrollTop = parseInt({{ ccp_scroll_top|default(0)|json_encode }}, 10);
    if (scrollTop > 0) window.setTimeout(function(){ window.scrollTo(0, scrollTop); }, 120);
  }

  function buildSearchIndex() {
    var index = [];
    var seen = {};
    var menu = root.querySelector('[data-ccp-tab-menu]');
    if (menu) {
      Array.prototype.forEach.call(menu.querySelectorAll('li > a[href^="#"]'), function(link){
        var title = cleanText(link.textContent);
        var mainId = cleanTabId(link.getAttribute('href'));
        if (!title || !mainId) return;
        index.push({type:'section', title:title, section:'', mainId:mainId, innerId:'', target:link.parentNode, search:normalize(title + ' ' + mainId)});
      });
    }
    Array.prototype.forEach.call(root.querySelectorAll('#form-codecart-pro .form-group'), function(group){
      var label = group.querySelector('.control-label,label');
      var help = group.querySelector('.help-block');
      var legend = group.closest('fieldset') ? group.closest('fieldset').querySelector('legend') : null;
      var title = cleanText(label ? label.textContent : '');
      if (!title) return;
      var fields = [];
      Array.prototype.forEach.call(group.querySelectorAll('input,select,textarea'), function(field){
        fields.push(field.getAttribute('name') || '', field.getAttribute('id') || '', field.getAttribute('placeholder') || '');
        if (field.tagName === 'SELECT') Array.prototype.forEach.call(field.options || [], function(option){ fields.push(option.text || ''); });
      });
      var mainPane = findMainPane(group);
      var innerPane = findInnerPane(group);
      var section = cleanText([mainPane ? labelForPane(mainPane.id) : '', innerPane ? labelForPane(innerPane.id) : '', legend ? legend.textContent : ''].join(' / ')).replace(/\s+\/\s+\/\s+/g, ' / ');
      var key = (mainPane ? mainPane.id : '') + '|' + (innerPane ? innerPane.id : '') + '|' + title;
      if (seen[key]) return;
      seen[key] = true;
      index.push({type:'setting', title:title, section:section, mainId:mainPane ? mainPane.id : '', innerId:innerPane ? innerPane.id : '', target:group, search:normalize([title, help ? help.textContent : '', section, fields.join(' ')].join(' '))});
    });
    return index;
  }

  function findMainPane(element) {
    var node = element;
    while (node && node !== document) {
      if (node.classList && node.classList.contains('tab-pane') && node.parentNode && node.parentNode.classList && node.parentNode.classList.contains('ccp-tab-content')) return node;
      node = node.parentNode;
    }
    return null;
  }

  function findInnerPane(element) {
    var node = element;
    while (node && node !== document) {
      if (node.classList && node.classList.contains('tab-pane') && node.parentNode && node.parentNode.classList && node.parentNode.classList.contains('ccp-inner-content')) return node;
      node = node.parentNode;
    }
    return null;
  }

  function labelForPane(id) {
    var link = root.querySelector('a[href="#' + id + '"]');
    return link ? cleanText(link.textContent) : '';
  }

  function scoreItem(item, query, words) {
    var haystack = item.search || normalize((item.title || '') + ' ' + (item.section || ''));
    for (var i = 0; i < words.length; i++) if (haystack.indexOf(words[i]) === -1) return -1;
    var title = normalize(item.title || '');
    var section = normalize(item.section || '');
    var score = 0;
    if (title === query) score += 100;
    if (title.indexOf(query) !== -1) score += 70;
    if (section.indexOf(query) !== -1) score += 25;
    if (item.type === 'setting') score += 15;
    score += Math.max(0, 20 - title.length / 8);
    return score;
  }

  function activateSearchResult(item, resultsBox, input) {
    if (!item) return;
    if (resultsBox) resultsBox.style.display = 'none';
    resetLeftMenu();
    var main = item.mainId ? root.querySelector('.ccp-tabs a[href="#' + item.mainId + '"]') : null;
    if (main) {
      var group = closest(main, '.ccp-tab-group');
      if (group) group.classList.add('is-open');
      showTab(main);
    }
    window.setTimeout(function(){
      var inner = item.innerId ? root.querySelector('#' + item.mainId + ' a[href="#' + item.innerId + '"]') : null;
      if (inner) showTab(inner);
      window.setTimeout(function(){
        if (item.target && item.target.scrollIntoView) {
          var repeater = item.target.closest ? item.target.closest('.ccp-repeater-card') : null;
          if (repeater) repeater.classList.remove('is-collapsed');
          item.target.classList.add('ccp-search-hit');
          item.target.scrollIntoView({behavior:'smooth', block:'center'});
          window.setTimeout(function(){ item.target.classList.remove('ccp-search-hit'); }, 1700);
        }
        if (input) input.blur();
      }, 120);
    }, 120);
  }

  function initSearch() {
    var input = root.querySelector('[data-ccp-tab-search]');
    var box = root.querySelector('[data-ccp-search-results]');
    if (!input || !box || input.getAttribute('data-ccp-ready') === '1') return;
    input.setAttribute('data-ccp-ready', '1');
    var index = [];
    function render() {
      resetLeftMenu();
      var query = normalize(input.value);
      if (!query) { box.innerHTML = ''; box.style.display = 'none'; return; }
      if (!index.length) index = buildSearchIndex();
      var words = query.split(' ').filter(Boolean);
      var results = index.map(function(item){ return {item:item, score:scoreItem(item, query, words)}; }).filter(function(row){ return row.score >= 0; }).sort(function(a,b){ return b.score - a.score; }).slice(0,14).map(function(row){ return row.item; });
      if (!results.length) { box.innerHTML = '<div class="ccp-admin-search-empty">' + escapeHtml(textNoMatches) + '</div>'; box.style.display = 'block'; return; }
      box.innerHTML = results.map(function(item, i){
        var icon = item.type === 'section' ? 'fa-folder-open' : 'fa-sliders';
        var section = item.section ? '<small>' + escapeHtml(item.section) + '</small>' : '';
        return '<button type="button" data-ccp-search-result="' + i + '"><i class="fa ' + icon + '"></i><span>' + escapeHtml(item.title) + '</span>' + section + '</button>';
      }).join('');
      box.style.display = 'block';
      Array.prototype.forEach.call(box.querySelectorAll('[data-ccp-search-result]'), function(button){
        button.addEventListener('click', function(e){
          e.preventDefault();
          activateSearchResult(results[parseInt(button.getAttribute('data-ccp-search-result'), 10)], box, input);
        });
      });
    }
    input.addEventListener('input', render);
    input.addEventListener('focus', function(){ if (input.value) render(); });
    input.addEventListener('keydown', function(e){
      if (e.key === 'Escape') { input.value = ''; box.innerHTML = ''; box.style.display = 'none'; resetLeftMenu(); }
    });
    document.addEventListener('click', function(e){
      if (!closest(e.target, '[data-ccp-tab-search]') && !closest(e.target, '[data-ccp-search-results]')) box.style.display = 'none';
    });
  }

  function initFilemanager() {
    document.addEventListener('click', function(e){
      var pick = closest(e.target, '[data-ccp-filemanager]');
      if (pick) {
        e.preventDefault();
        var target = pick.getAttribute('data-target');
        if (!target || !window.jQuery) return;
        jQuery('#modal-image').remove();
        jQuery.ajax({
          url: filemanagerUrl + '&target=' + encodeURIComponent(target),
          dataType: 'html',
          success: function(html) {
            jQuery('body').append('<div id="modal-image" class="modal fade" tabindex="-1" role="dialog">' + html + '</div>');
            jQuery('#modal-image').on('hidden.bs.modal', function(){ jQuery(this).remove(); cleanModalState(); }).modal('show');
          },
          error: cleanModalState
        });
        return;
      }
      var clear = closest(e.target, '[data-ccp-clear-target]');
      if (clear) {
        e.preventDefault();
        var id = clear.getAttribute('data-ccp-clear-target');
        var field = document.getElementById(id);
        if (field) { field.value = ''; field.dispatchEvent(new Event('change', {bubbles:true})); }
        return;
      }
      var preset = closest(e.target, '[data-ccp-link-preset]');
      if (preset) {
        e.preventDefault();
        var helper = closest(preset, '.ccp-link-helper');
        var group = helper ? closest(helper, '.col-sm-10') : null;
        var input = group ? group.querySelector('.ccp-link-input') : null;
        if (input) { input.value = preset.getAttribute('data-ccp-link-preset') || ''; input.dispatchEvent(new Event('change', {bubbles:true})); }
      }
    });
    if (window.jQuery) jQuery(document).on('hidden.bs.modal', cleanModalState);
  }

  function linkSearchUrl(type, query) {
    if (type === 'product') return productAutocompleteUrl + '&filter_name=' + encodeURIComponent(query);
    if (type === 'information') return informationAutocompleteUrl + '&filter_name=' + encodeURIComponent(query);
    return categoryAutocompleteUrl + '&filter_name=' + encodeURIComponent(query);
  }

  function linkRoute(type, item) {
    if (type === 'product') return 'index.php?route=product/product&product_id=' + encodeURIComponent(item.product_id || item.value || '');
    if (type === 'information') return 'index.php?route=information/information&information_id=' + encodeURIComponent(item.information_id || item.value || '');
    return 'index.php?route=product/category&path=' + encodeURIComponent(item.category_id || item.value || '');
  }

  function initLinkSearch() {
    var timers = new WeakMap();
    Array.prototype.forEach.call(root.querySelectorAll('.ccp-link-search'), function(input){
      if (input.getAttribute('data-ccp-ready') === '1') return;
      input.setAttribute('data-ccp-ready', '1');
      input.addEventListener('input', function(){
        var row = closest(input, '.ccp-link-search-row');
        if (!row) return;
        var results = row.querySelector('.ccp-link-results');
        var typeField = row.querySelector('.ccp-link-type');
        var type = typeField ? typeField.value : 'category';
        var q = cleanText(input.value);
        if (timers.get(input)) window.clearTimeout(timers.get(input));
        if (!q || q.length < 2) { if (results) { results.innerHTML = ''; results.style.display = 'none'; } return; }
        timers.set(input, window.setTimeout(function(){
          if (!window.jQuery || !results) return;
          jQuery.ajax({url:linkSearchUrl(type, q), dataType:'json', success:function(json){
            var items = Array.isArray(json) ? json.slice(0,12) : [];
            if (!items.length) { results.innerHTML = '<div class="ccp-link-empty">' + escapeHtml(textNoMatches) + '</div>'; results.style.display = 'block'; return; }
            results.innerHTML = items.map(function(item, index){
              var name = item.name || item.label || item.title || '';
              return '<button type="button" data-index="' + index + '"><i class="fa fa-link"></i><span>' + escapeHtml(name) + '</span></button>';
            }).join('');
            results.style.display = 'block';
            Array.prototype.forEach.call(results.querySelectorAll('button[data-index]'), function(button){
              button.addEventListener('click', function(e){
                e.preventDefault();
                var item = items[parseInt(button.getAttribute('data-index'), 10)];
                var helper = closest(row, '.ccp-link-helper');
                var group = helper ? closest(helper, '.col-sm-10') : null;
                var linkInput = group ? group.querySelector('.ccp-link-input') : null;
                if (linkInput) { linkInput.value = linkRoute(type, item); linkInput.dispatchEvent(new Event('change', {bubbles:true})); }
                input.value = item.name || item.label || item.title || '';
                results.style.display = 'none';
              });
            });
          }});
        }, 260));
      });
    });
    document.addEventListener('click', function(e){
      if (!closest(e.target, '.ccp-link-search-row')) Array.prototype.forEach.call(root.querySelectorAll('.ccp-link-results'), function(box){ box.style.display = 'none'; });
    });
  }

  function initIconPicker() {
    document.addEventListener('click', function(e){
      var button = closest(e.target, '[data-ccp-icon-value]');
      if (!button) return;
      e.preventDefault();
      var value = button.getAttribute('data-ccp-icon-value') || '';
      var target = button.getAttribute('data-ccp-icon-target') || '';
      var input = root.querySelector('[data-ccp-icon-input="' + target + '"]');
      var preview = root.querySelector('[data-ccp-icon-preview="' + target + '"]');
      if (input) { input.value = value; input.dispatchEvent(new Event('change', {bubbles:true})); }
      if (preview) preview.className = 'fa ' + value;
    });
  }

  initSettingsMenuToggle();
  initInnerTabs();
  initRepeaterCards();
  initSectionIntros();
  enhanceMediaPickers();
  initCodeareas();
  initColors();
  initTabGroups();
  initScrollSave();
  initSearch();
  initFilemanager();
  initLinkSearch();
  initIconPicker();
  restoreActiveTab();
  normalizeTabGroups();
  buildStructuredLayout();

  if (window.jQuery) jQuery(document).on('shown.bs.tab ccpAdminLayoutRefresh', function(){ window.setTimeout(buildStructuredLayout, 60); });
  document.addEventListener('shown.bs.tab', function(){ window.setTimeout(buildStructuredLayout, 60); }, true);
  window.setTimeout(buildStructuredLayout, 140);
})();
</script>

