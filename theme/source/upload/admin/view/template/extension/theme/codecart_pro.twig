          <div class="ccp-sticky-actions" data-ccp-sticky-actions aria-live="polite">
            <div class="ccp-sticky-state"><i class="fa fa-circle-o"></i><span data-ccp-form-state-text data-dirty-text="{{ text_unsaved_changes }}">{{ text_no_unsaved_changes }}</span><small data-ccp-current-section>{{ text_general }}</small></div>
            <div class="ccp-sticky-buttons"><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ button_cancel }}</a><button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button></div>
