              <div class="table-responsive ccp-diagnostics-table"><table class="table table-hover"><thead><tr><th>{{ text_check }}</th><th>{{ text_value }}</th><th>{{ text_status }}</th></tr></thead><tbody>{% for item in diagnostics %}<tr data-ccp-diag-status="{{ item.status }}"><td><strong>{{ item.label }}</strong></td><td>{{ item.value }}</td><td><span class="ccp-diag-badge is-{{ item.status }}"><i class="fa {{ item.status == 'good' ? 'fa-check-circle' : (item.status == 'warning' ? 'fa-exclamation-triangle' : 'fa-times-circle') }}"></i> {{ item.status == 'good' ? text_good : (item.status == 'warning' ? text_warning : text_bad) }}</span></td></tr>{% endfor %}</tbody></table></div>
            </div>
            <div class="tab-pane" id="tab-about">
              <div class="ccp-hero ccp-about-hero">
            <div class="ccp-hero-preview">
              <img src="{{ theme_preview }}" alt="{{ text_theme_preview }}" />
            </div>
            <div class="ccp-hero-main">
              <div class="ccp-hero-kicker"><span class="ccp-pro-badge">PRO</span> {{ text_theme_dashboard }}</div>
              <h2>CodeCart PRO Theme</h2>
              <p>{{ text_about_description }}</p>
              <div class="ccp-hero-status">
                <span class="ccp-status-pill {{ theme_enabled ? 'is-on' : 'is-off' }}"><i class="fa {{ theme_enabled ? 'fa-check-circle' : 'fa-exclamation-circle' }}"></i> {{ theme_enabled ? text_theme_enabled : text_theme_disabled }}</span>
                <span class="ccp-status-pill {{ theme_selected ? 'is-on' : 'is-warn' }}"><i class="fa {{ theme_selected ? 'fa-check-circle' : 'fa-info-circle' }}"></i> {{ theme_selected ? text_theme_selected : text_theme_not_selected }}</span>
                <span class="ccp-status-pill"><i class="fa fa-folder-open"></i> {{ text_theme_directory }}: {{ theme_directory }}</span>
