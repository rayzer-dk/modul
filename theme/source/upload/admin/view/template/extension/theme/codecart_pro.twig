                {{ ccp.select(entry_direct_checkout_after_add_status, 'theme_codecart_pro_direct_checkout_after_add_status', theme_codecart_pro_direct_checkout_after_add_status, help_direct_checkout_after_add, text_enabled, text_disabled) }}
                {{ ccp.select(entry_checkout_digital_mode, 'theme_codecart_pro_checkout_digital_mode', theme_codecart_pro_checkout_digital_mode, help_checkout_digital_mode, text_enabled, text_disabled) }}
                {{ ccp.select(entry_checkout_digital_instruction_status, 'theme_codecart_pro_checkout_digital_instruction_status', theme_codecart_pro_checkout_digital_instruction_status, help_checkout_digital_instruction, text_enabled, text_disabled) }}
                {{ ccp.select(entry_checkout_hide_reward_status, 'theme_codecart_pro_checkout_hide_reward_status', theme_codecart_pro_checkout_hide_reward_status, help_checkout_hide_totals, text_yes, text_no) }}
                {{ ccp.select(entry_checkout_hide_coupon_status, 'theme_codecart_pro_checkout_hide_coupon_status', theme_codecart_pro_checkout_hide_coupon_status, help_checkout_hide_totals, text_yes, text_no) }}
                {{ ccp.select(entry_checkout_hide_voucher_status, 'theme_codecart_pro_checkout_hide_voucher_status', theme_codecart_pro_checkout_hide_voucher_status, help_checkout_hide_totals, text_yes, text_no) }}
                {{ ccp.select(entry_checkout_compact_status, 'theme_codecart_pro_checkout_compact_status', theme_codecart_pro_checkout_compact_status, '', text_yes, text_no) }}
                <div class="form-group"><label class="col-sm-2 control-label">{{ entry_checkout_digital_instruction_text }}</label><div class="col-sm-10"><ul class="nav nav-tabs">{% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#ccp-checkout-digital-instruction-{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>{% endfor %}</ul><div class="tab-content">{% for language in languages %}<div class="tab-pane{% if loop.first %} active{% endif %}" id="ccp-checkout-digital-instruction-{{ language.language_id }}"><textarea name="theme_codecart_pro_checkout_digital_instruction_text[{{ language.language_id }}]" rows="3" class="form-control" placeholder="{{ entry_checkout_digital_instruction_text }}">{{ theme_codecart_pro_checkout_digital_instruction_text[language.language_id] is defined ? theme_codecart_pro_checkout_digital_instruction_text[language.language_id] : '' }}</textarea><p class="help-block">{{ help_checkout_digital_instruction }}</p></div>{% endfor %}</div></div></div>
                <div class="form-group"><label class="col-sm-2 control-label">{{ entry_checkout_trust_text }}</label><div class="col-sm-10"><ul class="nav nav-tabs">{% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#ccp-checkout-trust-{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>{% endfor %}</ul><div class="tab-content">{% for language in languages %}<div class="tab-pane{% if loop.first %} active{% endif %}" id="ccp-checkout-trust-{{ language.language_id }}"><textarea name="theme_codecart_pro_checkout_trust_text[{{ language.language_id }}]" rows="3" class="form-control" placeholder="Secure checkout|Delivery options|Manager confirmation">{{ theme_codecart_pro_checkout_trust_text[language.language_id] is defined ? theme_codecart_pro_checkout_trust_text[language.language_id] : '' }}</textarea><p class="help-block">{{ help_one_item_per_line }}</p></div>{% endfor %}</div></div></div>
              </fieldset>
            </div>
            <div class="tab-pane" id="tab-diagnostics" data-ccp-diagnostics>
              <div class="ccp-diagnostics-head">
                <div><h2><i class="fa fa-stethoscope"></i> {{ text_diagnostics }}</h2><p>{{ help_diagnostics_safe }}</p></div>
                <div class="ccp-diagnostic-score {{ diagnostic_summary.bad > 0 ? 'is-danger' : (diagnostic_summary.warning > 0 ? 'is-warning' : 'is-good') }}"><strong>{{ diagnostic_summary.good }}</strong><span>/ {{ diagnostic_summary.total }}</span></div>
              </div>
              <div class="ccp-diagnostic-filters" role="group" aria-label="{{ text_diagnostics }}">
                <button type="button" class="btn active" data-ccp-diag-filter="all">{{ text_diag_filter_all }} <b>{{ diagnostic_summary.total }}</b></button>
                <button type="button" class="btn" data-ccp-diag-filter="good">{{ text_diag_filter_good }} <b>{{ diagnostic_summary.good }}</b></button>
                <button type="button" class="btn" data-ccp-diag-filter="warning">{{ text_diag_filter_warning }} <b>{{ diagnostic_summary.warning }}</b></button>
                <button type="button" class="btn" data-ccp-diag-filter="bad">{{ text_diag_filter_bad }} <b>{{ diagnostic_summary.bad }}</b></button>
