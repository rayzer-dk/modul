{{ header }}{{ column_left }}
{% import _self as ccp %}
<div id="content" class="ccp-admin ccp-admin-v626" data-ccp-native-collapse-text="{{ text_native_collapse_to_icons|e('html_attr') }}" data-ccp-native-hide-text="{{ text_native_hide_menu|e('html_attr') }}" data-ccp-native-show-text="{{ text_native_show_menu|e('html_attr') }}" data-ccp-opencart-menu-text="{{ text_open_cart_menu|e('html_attr') }}" data-ccp-settings-label="{{ text_inner_settings|e('html_attr') }}">
  <div class="page-header">
    <div class="container-fluid">
    {% if ccp_sys_input_vars is defined and ccp_sys_input_vars and ccp_sys_input_vars < 3000 %}<div class="alert alert-warning ccp-server-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_max_input_vars_warning|format(ccp_sys_input_vars) }}</div>{% endif %}
      <div class="pull-right ccp-page-actions">
        <button type="submit" form="form-codecart-pro" class="btn btn-primary ccp-save-primary"><i class="fa fa-save"></i> <span>{{ button_save }}</span></button>
        <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> <span>{{ button_cancel }}</span></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="panel panel-default ccp-panel">
      <div class="panel-heading ccp-admin-panel-heading"><h3 class="panel-title"><i class="fa fa-paint-brush"></i> {{ text_edit }}</h3><span class="ccp-meta">{{ text_version }} {{ version }} · {{ text_author }} <a href="{{ author_url }}" target="_blank">CodeCart PRO</a></span></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-codecart-pro" class="form-horizontal" data-ccp-settings-form>
          <input type="hidden" name="ccp_active_tab" id="ccp-active-tab" value="{{ ccp_active_tab|default('') }}" />
          <input type="hidden" name="ccp_scroll_top" id="ccp-scroll-top" value="{{ ccp_scroll_top|default(0) }}" />
          <div class="ccp-admin-shell">
            <aside class="ccp-admin-sidebar">
              <div class="ccp-sidebar-title"><i class="fa fa-sliders"></i> <span>{{ text_theme_dashboard }}</span></div>
              <div class="ccp-sidebar-tools">
                <div class="ccp-tab-search-wrap"><i class="fa fa-search"></i><input type="text" class="form-control input-sm" data-ccp-tab-search placeholder="{{ text_tab_search }}" autocomplete="off" /><div class="ccp-admin-search-results" data-ccp-search-results></div></div>
                <button type="button" class="btn btn-default btn-xs ccp-collapse-theme-menu" data-ccp-theme-menu-toggle title="{{ text_compact_menu }}" aria-label="{{ text_compact_menu }}"><i class="fa fa-angle-left"></i></button>
              </div>
          <div id="ccp-theme-navigation" class="ccp-tab-groups" data-ccp-tab-menu>
            <div class="ccp-tab-group is-open" data-ccp-admin-group="base">
              <button type="button" class="ccp-tab-group-title"><span><i class="fa fa-paint-brush"></i> {{ text_group_base }}</span><i class="fa fa-chevron-down"></i></button>
              <ul class="nav nav-tabs ccp-tabs">
                <li class="active" data-ccp-tab-group="base"><a href="#tab-general" data-toggle="tab"><i class="fa fa-cog"></i> {{ text_general }}</a></li>
                <li data-ccp-tab-group="base"><a href="#tab-header" data-toggle="tab"><i class="fa fa-window-maximize"></i> {{ text_header }}</a></li>
                <li data-ccp-tab-group="base"><a href="#tab-home-builder" data-toggle="tab"><i class="fa fa-home"></i> {{ text_home_builder }}</a></li>
              </ul>
            </div>
            <div class="ccp-tab-group is-open" data-ccp-admin-group="catalog">
              <button type="button" class="ccp-tab-group-title"><span><i class="fa fa-cubes"></i> {{ text_group_catalog }}</span><i class="fa fa-chevron-down"></i></button>
              <ul class="nav nav-tabs ccp-tabs">
                <li data-ccp-tab-group="catalog"><a href="#tab-cards" data-toggle="tab"><i class="fa fa-th"></i> {{ text_cards }}</a></li>
                <li data-ccp-tab-group="catalog"><a href="#tab-category" data-toggle="tab"><i class="fa fa-folder-open"></i> {{ text_category }}</a></li>
                <li data-ccp-tab-group="catalog"><a href="#tab-product" data-toggle="tab"><i class="fa fa-cube"></i> {{ text_product }}</a></li>
                <li data-ccp-tab-group="catalog"><a href="#tab-product-ux" data-toggle="tab"><i class="fa fa-magic"></i> {{ text_product_ux }}</a></li>
                <li data-ccp-tab-group="catalog"><a href="#tab-product-modules" data-toggle="tab"><i class="fa fa-cubes"></i> {{ text_product_modules }}</a></li>
                <li data-ccp-tab-group="catalog"><a href="#tab-storefront-depth" data-toggle="tab"><i class="fa fa-line-chart"></i> {{ text_storefront_depth }}</a></li>
              </ul>
            </div>
            <div class="ccp-tab-group" data-ccp-admin-group="sales">
              <button type="button" class="ccp-tab-group-title"><span><i class="fa fa-shopping-bag"></i> {{ text_group_sales }}</span><i class="fa fa-chevron-down"></i></button>
              <ul class="nav nav-tabs ccp-tabs">
                <li data-ccp-tab-group="sales"><a href="#tab-mobile" data-toggle="tab"><i class="fa fa-mobile"></i> {{ text_mobile }}</a></li>
                <li data-ccp-tab-group="sales"><a href="#tab-commerce" data-toggle="tab"><i class="fa fa-shopping-bag"></i> {{ text_commerce_ux }}</a></li>
                <li data-ccp-tab-group="sales"><a href="#tab-mega-menu" data-toggle="tab"><i class="fa fa-bars"></i> {{ text_mega_menu }}</a></li>
                <li data-ccp-tab-group="sales"><a href="#tab-interactions" data-toggle="tab"><i class="fa fa-comments"></i> {{ text_interactions }}</a></li>
                <li data-ccp-tab-group="sales"><a href="#tab-requests" data-toggle="tab"><i class="fa fa-list"></i> {{ text_requests }}</a></li>
              </ul>
            </div>
            <div class="ccp-tab-group" data-ccp-admin-group="seo">
              <button type="button" class="ccp-tab-group-title"><span><i class="fa fa-search"></i> {{ text_group_seo }}</span><i class="fa fa-chevron-down"></i></button>
              <ul class="nav nav-tabs ccp-tabs">
                <li data-ccp-tab-group="seo"><a href="#tab-seo-content" data-toggle="tab"><i class="fa fa-search"></i> {{ text_seo_content }}</a></li>
              </ul>
            </div>
            <div class="ccp-tab-group" data-ccp-admin-group="service">
              <button type="button" class="ccp-tab-group-title"><span><i class="fa fa-wrench"></i> {{ text_group_service }}</span><i class="fa fa-chevron-down"></i></button>
              <ul class="nav nav-tabs ccp-tabs">
                <li data-ccp-tab-group="service"><a href="#tab-performance" data-toggle="tab"><i class="fa fa-bolt"></i> {{ text_performance }}</a></li>
                <li data-ccp-tab-group="service"><a href="#tab-code" data-toggle="tab"><i class="fa fa-code"></i> {{ text_custom_code }}</a></li>
                <li data-ccp-tab-group="service"><a href="#tab-release-tools" data-toggle="tab"><i class="fa fa-wrench"></i> {{ text_release_tools }}</a></li>
                <li data-ccp-tab-group="service"><a href="#tab-diagnostics" data-toggle="tab"><i class="fa fa-stethoscope"></i> {{ text_diagnostics }}</a></li>
                <li data-ccp-tab-group="service"><a href="#tab-about" data-toggle="tab"><i class="fa fa-info-circle"></i> {{ text_about }}</a></li>
              </ul>
            </div>
          </div>
            </aside>
            <section class="ccp-admin-main">
          <div class="tab-content ccp-tab-content">
            <div class="tab-pane active" id="tab-general">
              <section class="ccp-overview" aria-label="{{ text_admin_overview }}">
                <div class="ccp-overview-head">
                  <div>
                    <span class="ccp-overview-kicker"><i class="fa fa-sliders"></i> CodeCart PRO</span>
                    <h2>{{ text_admin_overview }}</h2>
                    <p>{{ text_admin_overview_help }}</p>
                  </div>
                  <div class="ccp-overview-version"><span>PRO</span><strong>v{{ version }}</strong></div>
                </div>
                <div class="ccp-overview-grid">
                  <div class="ccp-overview-card {{ theme_enabled ? 'is-good' : 'is-danger' }}">
                    <i class="fa {{ theme_enabled ? 'fa-check-circle' : 'fa-power-off' }}"></i>
                    <div><small>{{ text_status_theme }}</small><strong>{{ theme_enabled ? text_theme_enabled : text_theme_disabled }}</strong></div>
                  </div>
                  <div class="ccp-overview-card {{ theme_selected ? 'is-good' : 'is-warning' }}">
                    <i class="fa {{ theme_selected ? 'fa-check-circle' : 'fa-exclamation-triangle' }}"></i>
                    <div><small>{{ text_status_selected }}</small><strong>{{ theme_selected ? text_theme_selected : text_theme_not_selected }}</strong></div>
                  </div>
                  <div class="ccp-overview-card {{ theme_codecart_pro_information_mode ? 'is-info' : 'is-neutral' }}">
                    <i class="fa {{ theme_codecart_pro_information_mode ? 'fa-info-circle' : 'fa-shopping-cart' }}"></i>
                    <div><small>{{ text_status_information_mode }}</small><strong>{{ theme_codecart_pro_information_mode ? text_enabled : text_disabled }}</strong></div>
                  </div>
                  <div class="ccp-overview-card {{ diagnostic_summary.bad > 0 ? 'is-danger' : (diagnostic_summary.warning > 0 ? 'is-warning' : 'is-good') }}">
                    <i class="fa fa-stethoscope"></i>
                    <div><small>{{ text_status_diagnostics }}</small><strong>{{ diagnostic_summary.good }} / {{ diagnostic_summary.total }}</strong><span>{{ diagnostic_summary.warning }} {{ text_diag_warning_short }}, {{ diagnostic_summary.bad }} {{ text_diag_bad_short }}</span></div>
                  </div>
                </div>
                {% if not theme_selected %}<div class="ccp-overview-notice is-warning"><i class="fa fa-exclamation-triangle"></i><div><strong>{{ text_theme_not_selected }}</strong><span>{{ text_theme_not_selected_help }}</span></div><a href="{{ store_settings_url }}" class="btn btn-warning btn-sm">{{ text_store_settings }}</a></div>{% endif %}
                {% if not theme_enabled %}<div class="ccp-overview-notice is-danger"><i class="fa fa-power-off"></i><div><strong>{{ text_theme_disabled }}</strong><span>{{ text_theme_disabled_help }}</span></div></div>{% endif %}
                <div class="ccp-quick-actions">
                  <span class="ccp-quick-actions-title">{{ text_quick_actions }}</span>
                  <a href="{{ catalog_home_url }}" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> {{ text_open_storefront }}</a>
                  <a href="{{ blog_manager }}"><i class="fa fa-newspaper-o"></i> {{ button_blog_manager }}</a>
                  <a href="{{ review_manager }}"><i class="fa fa-star"></i> {{ button_review_manager }}</a>
                  <a href="{{ store_settings_url }}"><i class="fa fa-cogs"></i> {{ text_store_settings }}</a>
                </div>
              </section>
              <div class="row">
                <div class="col-sm-6">
                  <fieldset><legend>{{ text_general }}</legend>
                    {{ ccp.select(entry_status, 'theme_codecart_pro_status', theme_codecart_pro_status, help_status, text_enabled, text_disabled) }}
                    {{ ccp.select(entry_information_mode, 'theme_codecart_pro_information_mode', theme_codecart_pro_information_mode, help_information_mode, text_yes, text_no) }}
                    {{ ccp.select(entry_uninstall_keep_data, 'theme_codecart_pro_uninstall_keep_data', theme_codecart_pro_uninstall_keep_data, help_uninstall_keep_data, text_yes, text_no) }}
                    {{ ccp.number(entry_product_limit, 'theme_codecart_pro_product_limit', theme_codecart_pro_product_limit, help_product_limit) }}
                    {{ ccp.number(entry_product_description_length, 'theme_codecart_pro_product_description_length', theme_codecart_pro_product_description_length, help_product_description_length) }}
                  </fieldset>
                </div>
                <div class="col-sm-6">
                  <fieldset><legend>{{ text_design }}</legend>
                    {{ ccp.color(entry_primary_color, 'theme_codecart_pro_primary_color', theme_codecart_pro_primary_color, help_color) }}
                    {{ ccp.color(entry_accent_color, 'theme_codecart_pro_accent_color', theme_codecart_pro_accent_color, help_color) }}
                    {{ ccp.color(entry_success_color, 'theme_codecart_pro_success_color', theme_codecart_pro_success_color, help_color) }}
                    {{ ccp.color(entry_danger_color, 'theme_codecart_pro_danger_color', theme_codecart_pro_danger_color, help_color) }}
                    {{ ccp.color(entry_background_color, 'theme_codecart_pro_background_color', theme_codecart_pro_background_color, help_color) }}
                    {{ ccp.color(entry_page_side_background_color, 'theme_codecart_pro_page_side_background_color', theme_codecart_pro_page_side_background_color, help_color) }}
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_page_side_background_image }}</label><div class="col-sm-10"><div class="input-group ccp-media-picker"><input type="text" id="theme_codecart_pro_page_side_background_image" name="theme_codecart_pro_page_side_background_image" value="{{ theme_codecart_pro_page_side_background_image|escape }}" class="form-control" placeholder="catalog/backgrounds/site-bg.jpg" readonly /><span class="input-group-btn"><button type="button" class="btn btn-primary" data-ccp-filemanager data-target="theme_codecart_pro_page_side_background_image"><i class="fa fa-picture-o"></i> {{ text_choose_image }}</button><button type="button" class="btn btn-default" data-ccp-clear-target="theme_codecart_pro_page_side_background_image"><i class="fa fa-times"></i> {{ text_clear_image }}</button></span></div>{% if help_page_side_background_image %}<p class="help-block">{{ help_page_side_background_image }}</p>{% endif %}</div></div>
                    {{ ccp.color(entry_text_color, 'theme_codecart_pro_text_color', theme_codecart_pro_text_color, help_color) }}
                  </fieldset>
                  <fieldset><legend><i class="fa fa-moon-o"></i> {{ text_dark_theme }}</legend>
                    {{ ccp.select(entry_dark_theme_status, 'theme_codecart_pro_dark_theme_status', theme_codecart_pro_dark_theme_status, help_dark_theme, text_yes, text_no) }}
                    {{ ccp.select(entry_dark_theme_default, 'theme_codecart_pro_dark_theme_default', theme_codecart_pro_dark_theme_default, '', text_yes, text_no) }}
                    {{ ccp.select(entry_dark_theme_show_toggle, 'theme_codecart_pro_dark_theme_show_toggle', theme_codecart_pro_dark_theme_show_toggle, '', text_yes, text_no) }}
                    {{ ccp.color(entry_dark_theme_background, 'theme_codecart_pro_dark_theme_background', theme_codecart_pro_dark_theme_background, help_color) }}
                    {{ ccp.color(entry_dark_theme_surface, 'theme_codecart_pro_dark_theme_surface', theme_codecart_pro_dark_theme_surface, help_color) }}
                    {{ ccp.color(entry_dark_theme_card, 'theme_codecart_pro_dark_theme_card', theme_codecart_pro_dark_theme_card, help_color) }}
                    {{ ccp.color(entry_dark_theme_text, 'theme_codecart_pro_dark_theme_text', theme_codecart_pro_dark_theme_text, help_color) }}
                    {{ ccp.color(entry_dark_theme_muted, 'theme_codecart_pro_dark_theme_muted', theme_codecart_pro_dark_theme_muted, help_color) }}
                    {{ ccp.color(entry_dark_theme_border, 'theme_codecart_pro_dark_theme_border', theme_codecart_pro_dark_theme_border, help_color) }}
                  </fieldset>
                  <fieldset><legend>{{ text_design }}</legend>
                    {{ ccp.number(entry_container_width, 'theme_codecart_pro_container_width', theme_codecart_pro_container_width, '', text_px) }}
                    {{ ccp.number(entry_element_radius, 'theme_codecart_pro_element_radius', theme_codecart_pro_element_radius, '', text_px) }}
                    {{ ccp.number(entry_card_radius, 'theme_codecart_pro_card_radius', theme_codecart_pro_card_radius, '', text_px) }}
                    {{ ccp.number(entry_button_radius, 'theme_codecart_pro_button_radius', theme_codecart_pro_button_radius, '', text_px) }}
                    {{ ccp.select(entry_card_shadow, 'theme_codecart_pro_card_shadow', theme_codecart_pro_card_shadow, '', text_yes, text_no) }}
                  </fieldset>
                </div>
              </div>
              <fieldset class="ccp-fieldset-images"><legend>{{ text_images }}</legend><div class="ccp-size-grid">
                {{ ccp.size(entry_image_category, 'theme_codecart_pro_image_category', theme_codecart_pro_image_category_width, theme_codecart_pro_image_category_height, text_width, text_height) }}
                {{ ccp.size(entry_image_thumb, 'theme_codecart_pro_image_thumb', theme_codecart_pro_image_thumb_width, theme_codecart_pro_image_thumb_height, text_width, text_height) }}
                {{ ccp.size(entry_image_popup, 'theme_codecart_pro_image_popup', theme_codecart_pro_image_popup_width, theme_codecart_pro_image_popup_height, text_width, text_height) }}
                {{ ccp.size(entry_image_product, 'theme_codecart_pro_image_product', theme_codecart_pro_image_product_width, theme_codecart_pro_image_product_height, text_width, text_height) }}
                {{ ccp.size(entry_image_additional, 'theme_codecart_pro_image_additional', theme_codecart_pro_image_additional_width, theme_codecart_pro_image_additional_height, text_width, text_height) }}
                {{ ccp.size(entry_image_related, 'theme_codecart_pro_image_related', theme_codecart_pro_image_related_width, theme_codecart_pro_image_related_height, text_width, text_height) }}
                {{ ccp.size(entry_image_compare, 'theme_codecart_pro_image_compare', theme_codecart_pro_image_compare_width, theme_codecart_pro_image_compare_height, text_width, text_height) }}
                {{ ccp.size(entry_image_wishlist, 'theme_codecart_pro_image_wishlist', theme_codecart_pro_image_wishlist_width, theme_codecart_pro_image_wishlist_height, text_width, text_height) }}
                {{ ccp.size(entry_image_cart, 'theme_codecart_pro_image_cart', theme_codecart_pro_image_cart_width, theme_codecart_pro_image_cart_height, text_width, text_height) }}
                {{ ccp.size(entry_image_location, 'theme_codecart_pro_image_location', theme_codecart_pro_image_location_width, theme_codecart_pro_image_location_height, text_width, text_height) }}
              </div></fieldset>
            </div>
            <div class="tab-pane" id="tab-header">
              {{ ccp.select(entry_show_top_bar, 'theme_codecart_pro_show_top_bar', theme_codecart_pro_show_top_bar, '', text_yes, text_no) }}
              {{ ccp.select(entry_sticky_header, 'theme_codecart_pro_sticky_header', theme_codecart_pro_sticky_header, '', text_yes, text_no) }}
              {{ ccp.select(entry_compact_header, 'theme_codecart_pro_compact_header', theme_codecart_pro_compact_header, '', text_yes, text_no) }}
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_header_notice }}</label><div class="col-sm-10">
                <ul class="nav nav-tabs" id="ccp-notice-lang">{% for language in languages %}<li{% if loop.first %} class="active"{% endif %}><a href="#notice-lang-{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" onerror="this.style.display='none'" /> {{ language.name }}</a></li>{% endfor %}</ul>
                <div class="tab-content">{% for language in languages %}<div class="tab-pane{% if loop.first %} active{% endif %}" id="notice-lang-{{ language.language_id }}"><input type="text" name="theme_codecart_pro_header_notice[{{ language.language_id }}]" value="{{ theme_codecart_pro_header_notice[language.language_id] is defined ? theme_codecart_pro_header_notice[language.language_id] : '' }}" class="form-control" placeholder="{{ help_header_notice }}" /></div>{% endfor %}</div>
                <p class="help-block">{{ help_header_notice }}</p>
              </div></div>
            </div>

            <div class="tab-pane" id="tab-home-builder">
              <fieldset><legend>{{ text_home_builder }}</legend>
                {{ ccp.select(entry_home_builder_status, 'theme_codecart_pro_home_builder_status', theme_codecart_pro_home_builder_status, '', text_yes, text_no) }}
                {{ ccp.select(entry_home_slider_status, 'theme_codecart_pro_home_slider_status', theme_codecart_pro_home_slider_status, '', text_yes, text_no) }}
                {{ ccp.select(entry_home_slider_autoplay, 'theme_codecart_pro_home_slider_autoplay', theme_codecart_pro_home_slider_autoplay, '', text_yes, text_no) }}
                {{ ccp.number(entry_home_slider_height, 'theme_codecart_pro_home_slider_height', theme_codecart_pro_home_slider_height, '', text_px) }}
                <div class="ccp-admin-subtitle"><i class="fa fa-picture-o"></i> {{ text_custom_slideshow }}</div>
                {{ ccp.select(entry_custom_slideshow_status, 'theme_codecart_pro_custom_slideshow_status', theme_codecart_pro_custom_slideshow_status, help_custom_slideshow_status, text_yes, text_no) }}
                {{ ccp.select(entry_custom_slideshow_hide_native, 'theme_codecart_pro_custom_slideshow_hide_native', theme_codecart_pro_custom_slideshow_hide_native, help_custom_slideshow_hide_native, text_yes, text_no) }}
                {{ ccp.select(entry_custom_slideshow_show_text, 'theme_codecart_pro_custom_slideshow_show_text', theme_codecart_pro_custom_slideshow_show_text, '', text_yes, text_no) }}
                {{ ccp.number(entry_custom_slideshow_autoplay_delay, 'theme_codecart_pro_custom_slideshow_autoplay_delay', theme_codecart_pro_custom_slideshow_autoplay_delay, '', 'ms') }}
                {{ ccp.number(entry_custom_slideshow_height_desktop, 'theme_codecart_pro_custom_slideshow_height_desktop', theme_codecart_pro_custom_slideshow_height_desktop, '', text_px) }}
                {{ ccp.number(entry_custom_slideshow_height_tablet, 'theme_codecart_pro_custom_slideshow_height_tablet', theme_codecart_pro_custom_slideshow_height_tablet, '', text_px) }}
                {{ ccp.number(entry_custom_slideshow_height_mobile, 'theme_codecart_pro_custom_slideshow_height_mobile', theme_codecart_pro_custom_slideshow_height_mobile, '', text_px) }}
                <div class="form-group"><label class="col-sm-2 control-label">{{ entry_custom_slideshow_fit_mode }}</label><div class="col-sm-10"><select name="theme_codecart_pro_custom_slideshow_fit_mode" class="form-control"><option value="height"{% if theme_codecart_pro_custom_slideshow_fit_mode == 'height' %} selected{% endif %}>{{ text_fit_height }}</option><option value="width"{% if theme_codecart_pro_custom_slideshow_fit_mode == 'width' %} selected{% endif %}>{{ text_fit_width }}</option><option value="cover"{% if theme_codecart_pro_custom_slideshow_fit_mode == 'cover' %} selected{% endif %}>{{ text_fit_cover }}</option></select></div></div>
                <div class="form-group"><label class="col-sm-2 control-label">{{ entry_custom_slideshow_image_source }}</label><div class="col-sm-10"><select name="theme_codecart_pro_custom_slideshow_image_source" class="form-control"><option value="direct"{% if theme_codecart_pro_custom_slideshow_image_source == 'direct' %} selected{% endif %}>{{ text_image_source_direct }}</option><option value="cache"{% if theme_codecart_pro_custom_slideshow_image_source == 'cache' %} selected{% endif %}>{{ text_image_source_cache }}</option></select><p class="help-block">{{ help_custom_slideshow_image_source }}</p></div></div>
                {{ ccp.select(entry_mobile_hide_home_slider_status, 'theme_codecart_pro_mobile_hide_home_slider_status', theme_codecart_pro_mobile_hide_home_slider_status, help_mobile_hide_home_slider, text_yes, text_no) }}
                {{ ccp.select(entry_mobile_hide_native_slideshow_status, 'theme_codecart_pro_mobile_hide_native_slideshow_status', theme_codecart_pro_mobile_hide_native_slideshow_status, help_mobile_hide_native_slideshow, text_yes, text_no) }}
